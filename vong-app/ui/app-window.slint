// Vọng AI Recorder — main window.
//
// Single AppWindow with sidebar + two transcript columns (Bản gốc / Bản dịch)
// + mic record button between them. The previous floating-pill window was
// removed — too low-signal next to the main UI.
// Design tokens mirror `docs/design.md`.

import { VerticalBox, HorizontalBox, LineEdit, ComboBox, ScrollView, Slider } from "std-widgets.slint";
import { WizardOverlay } from "wizard.slint";

// Soniox-style transcript line — single utterance with timestamp + language tag.
//
// Carries TWO parallel renditions of the same utterance:
//   - `original-text` / `original-lang` — auto-detected ("Bản gốc")
//   - `text` / `lang` — language-hinted decode ("Bản phiên âm")
// UI renders them side-by-side in TranscriptStream.
struct TranscriptLine {
    seq: int,
    time: string,             // "14:30"
    lang: string,              // hinted/primary language, e.g. "vi"
    text: string,              // primary text ("Bản phiên âm")
    original-lang: string,     // auto-detected language, e.g. "en"
    original-text: string,     // auto-detected text ("Bản gốc")
    duration-ms: int,          // for confidence dimming if needed
    translation-done: bool,    // true once pass B has emitted Translation
}

// ---- Design tokens (mirrored from docs/design.md §1.2) ----
// Promote to vong-ui/ui/tokens.slint in Phase 5 and @import there.
global Tokens {
    // Surfaces
    out property <color> bg: #0A0A0A;
    out property <color> surface: #171717;
    out property <color> surface-hover: #262626;
    out property <color> border: #404040;

    // Text
    out property <color> text-primary: #FAFAFA;
    out property <color> text-secondary: #A3A3A3;
    out property <color> text-hint: #737373;

    // Accents
    out property <color> accent: #8B5CF6;        // violet 500
    out property <color> success: #4ADE80;       // green 400
    out property <color> danger: #F87171;        // red 400

    // Typography (px)
    out property <length> font-display: 48px;
    out property <length> font-h1: 28px;
    out property <length> font-h2: 20px;
    out property <length> font-body: 16px;
    out property <length> font-secondary: 14px;
    out property <length> font-caption: 12px;
}

component HeaderBar inherits Rectangle {
    callback settings-clicked();
    callback back-clicked();
    in property <bool> in-settings;

    height: 48px;
    background: Tokens.surface;
    border-width: 0px;
    drop-shadow-blur: 0px;

    HorizontalBox {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        HorizontalBox {
            spacing: 10px;
            alignment: start;

            if in-settings: back-touch := TouchArea {
                width: 32px;
                clicked => { root.back-clicked(); }
                Text {
                    text: "←";
                    font-size: 20px;
                    color: back-touch.has-hover ? Tokens.accent : Tokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: in-settings ? "⚙" : "🔊";
                font-size: 18px;
                vertical-alignment: center;
            }
            Text {
                text: in-settings ? "Cài đặt" : "Vọng AI Recorder";
                font-size: Tokens.font-body;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: end;

            Text {
                text: "v0.1.0-alpha";
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                vertical-alignment: center;
            }

            if !in-settings: gear-touch := TouchArea {
                width: 32px;
                height: 32px;
                clicked => { root.settings-clicked(); }
                Text {
                    text: "⚙";
                    font-size: 18px;
                    color: gear-touch.has-hover ? Tokens.accent : Tokens.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Bottom hairline border
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: parent.width; height: 1px;
        background: Tokens.border;
    }
}

// Compact peak meter strip — Soniox apps put this at bottom-of-main as a
// thin status bar. Status + footer text inline; the peak bar is the
// horizontal accent.
component PeakMeter inherits Rectangle {
    in property <float> level: 0.0;
    in property <string> status;
    in property <string> footer;

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;
    height: 88px;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalBox {
            spacing: 16px;
            alignment: space-between;
            Text {
                text: status;
                font-size: Tokens.font-secondary;
                color: Tokens.text-primary;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: footer;
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Track
        Rectangle {
            height: 6px;
            background: #1f1f1f;
            border-radius: 3px;
            border-width: 1px;
            border-color: Tokens.border;
            clip: true;

            // Fill — width = parent * level. Color thresholds match RMS guidance:
            //   0.0-0.70 green (safe), 0.70-0.90 yellow (warm), >0.90 red (clipping).
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * level;
                height: parent.height;
                border-radius: 3px;
                background: level > 0.9 ? Tokens.danger
                          : level > 0.7 ? #FBBF24
                          : Tokens.success;
                animate width { duration: 80ms; easing: ease-out; }
                animate background { duration: 120ms; }
            }
        }
    }
}

// OnboardingBanner removed — replaced by the full-screen WizardOverlay (wizard.slint).
// See AppWindow current-view == "wizard" routing below.

// Audio source picker — enumerates input + output devices. Selecting an output
// captures via WASAPI loopback (Windows system audio). Selection persists to
// config; restart required for the new source to take effect.
component AudioSourceCard inherits Rectangle {
    in property <[string]> sources;
    in property <string> current;
    in property <bool> restart-needed;
    callback selected(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Nguồn âm thanh";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        ComboBox {
            model: sources;
            current-value: current;
            selected(value) => {
                root.selected(value);
            }
        }

        if restart-needed: Text {
            text: "↻  Đã lưu — khởi động lại Vọng AI Recorder để áp dụng";
            font-size: Tokens.font-caption;
            color: Tokens.danger;
            wrap: no-wrap;
        }
    }
}

// Export action card — single button "📥 Xuất Markdown" + status text.
// Exports the most-recent session's segments to `~/Documents/Vong/`.
component ExportCard inherits Rectangle {
    in property <string> status;
    callback export-clicked();

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        btn := TouchArea {
            height: 32px;
            clicked => {
                root.export-clicked();
            }
            Rectangle {
                background: btn.has-hover ? Tokens.accent : #6d3fe0;
                border-radius: 4px;
                animate background { duration: 100ms; }
                Text {
                    text: "📥  Xuất phiên mới nhất → Markdown";
                    font-size: Tokens.font-caption;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Status only appears AFTER a click — gives user feedback without
        // duplicating the button label when idle.
        if status != "": Text {
            text: status;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}

// ── Phase 11: HistoryRowData struct + HistoryCard VecModel refactor ──────────

/// One row in the HistoryCard session list.
/// `summary-preview`: first 80 chars of the summary content, or "Chưa tóm tắt".
export struct HistoryRowData {
    session-id: int,
    started-at: string,   // "2025-05-23 14:30"
    duration: string,     // "5m 12s" or "—"
    provider: string,     // "Whisper local" | "Soniox" | "OpenAI"
    summary-preview: string,
}

// One clickable row in the HistoryCard list.
component HistoryRow inherits Rectangle {
    in property <HistoryRowData> data;
    callback clicked(int);

    background: touch.has-hover ? Tokens.surface-hover : transparent;
    border-radius: 6px;
    height: 64px;
    animate background { duration: 80ms; }

    touch := TouchArea {
        clicked => { root.clicked(root.data.session-id); }
    }

    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 4px;

        HorizontalBox {
            spacing: 8px;
            alignment: space-between;

            Text {
                text: data.started-at;
                font-size: Tokens.font-caption;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }

            Text {
                text: data.duration;
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 6px;
            alignment: start;

            Rectangle {
                background: #1e1333;
                border-radius: 3px;
                width: 52px;
                height: 16px;
                Text {
                    text: data.provider;
                    font-size: 9px;
                    color: Tokens.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            Text {
                text: data.summary-preview;
                font-size: Tokens.font-caption;
                color: Tokens.text-secondary;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }
    }

    // Right-pointing arrow indicator
    Text {
        x: parent.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        text: "›";
        font-size: 18px;
        color: touch.has-hover ? Tokens.accent : Tokens.text-hint;
        animate color { duration: 80ms; }
    }
}

// History + FTS5 search card — refactored from plain text to VecModel-driven rows.
// `history-model` is a [HistoryRowData] pushed by Rust at ~1 Hz.
// When search input is non-empty, `search-text` holds formatted FTS5 hits (legacy path).
component HistoryCard inherits Rectangle {
    in property <[HistoryRowData]> history-model: [];
    in property <string> search-text: "";   // FTS5 results when user is searching
    in property <bool> is-searching: false; // true while search query is non-empty
    callback search-changed(string);
    callback row-clicked(int);             // emits session_id

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Tìm + Lịch sử";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        LineEdit {
            placeholder-text: "Tìm trong tất cả phiên ghi…";
            edited(t) => {
                root.search-changed(t);
            }
        }

        // Search results (plain text, legacy FTS5 display)
        if is-searching: Text {
            text: search-text;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // Session rows (when not searching)
        if !is-searching: VerticalLayout {
            spacing: 2px;
            alignment: start;

            if history-model.length == 0: Text {
                text: "Chưa có phiên nào được lưu.";
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                horizontal-alignment: center;
            }

            for entry in history-model: HistoryRow {
                data: entry;
                clicked(id) => { root.row-clicked(id); }
            }
        }
    }
}

// ── Phase 11: SessionDetail components ───────────────────────────────────────

/// One row in the transcript segments list inside SessionDetail.
component TranscriptSegmentRow inherits Rectangle {
    in property <string> timestamp;      // "0:05"
    in property <string> speaker;        // "" or "Speaker 1"
    in property <string> segment-text;   // transcript text

    background: transparent;
    height: 40px;

    HorizontalBox {
        spacing: 10px;
        alignment: start;
        padding: 4px;

        Text {
            text: timestamp;
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            vertical-alignment: top;
            width: 40px;
        }

        if speaker != "": Text {
            text: speaker;
            font-size: Tokens.font-caption;
            color: Tokens.accent;
            font-weight: 600;
            vertical-alignment: top;
            width: 64px;
            overflow: elide;
        }

        Text {
            text: segment-text;
            font-size: Tokens.font-secondary;
            color: Tokens.text-primary;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: top;
        }
    }
}

/// Slint-side view-model for a single transcript segment in SessionDetail.
export struct DetailSegmentRow {
    timestamp: string,
    speaker: string,
    text: string,
}

/// Summary card at the top of the SessionDetail view.
/// Shows the summary text + Regenerate / Copy action buttons.
component SessionDetailCard inherits Rectangle {
    in property <string> summary-text: "";
    // "idle" | "computing" | "done" | "needs-api-key" | "error"
    in property <string> summary-state: "idle";
    in property <string> error-message: "";
    callback regenerate-clicked();
    callback copy-clicked();

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            alignment: space-between;

            HorizontalBox {
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 8px; height: 8px; border-radius: 4px;
                    background: Tokens.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "Tóm tắt phiên";
                    font-size: Tokens.font-secondary;
                    font-weight: 600;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
            }

            // Action buttons row (Regenerate + Copy)
            HorizontalBox {
                spacing: 6px;
                alignment: end;

                regen-btn := TouchArea {
                    width: 90px;
                    height: 28px;
                    enabled: summary-state != "computing";
                    clicked => { root.regenerate-clicked(); }
                    Rectangle {
                        background: regen-btn.has-hover && regen-btn.enabled
                            ? Tokens.accent : #3d2472;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Tokens.accent;
                        animate background { duration: 80ms; }
                        Text {
                            text: "↺ Tạo lại";
                            font-size: Tokens.font-caption;
                            font-weight: 600;
                            color: regen-btn.enabled ? Tokens.text-primary : Tokens.text-hint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                copy-btn := TouchArea {
                    width: 68px;
                    height: 28px;
                    enabled: summary-state == "done" && summary-text != "";
                    clicked => { root.copy-clicked(); }
                    Rectangle {
                        background: copy-btn.has-hover && copy-btn.enabled
                            ? Tokens.accent : #262626;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: copy-btn.enabled ? Tokens.accent : Tokens.border;
                        animate background { duration: 80ms; }
                        Text {
                            text: "📋 Sao chép";
                            font-size: Tokens.font-caption;
                            font-weight: 600;
                            color: copy-btn.enabled ? Tokens.text-primary : Tokens.text-hint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Summary body — conditional on state
        if summary-state == "computing": HorizontalBox {
            spacing: 8px;
            alignment: start;
            Text { text: "⏳"; font-size: 16px; color: Tokens.text-hint; vertical-alignment: center; }
            Text {
                text: "Đang tạo tóm tắt…";
                font-size: Tokens.font-secondary;
                color: Tokens.text-secondary;
                vertical-alignment: center;
            }
        }

        if summary-state == "needs-api-key": Text {
            text: "Cần API key OpenAI — cấu hình trong Cài đặt → System.";
            font-size: Tokens.font-secondary;
            color: Tokens.danger;
            wrap: word-wrap;
        }

        if summary-state == "error": Text {
            text: error-message != "" ? error-message : "Lỗi tạo tóm tắt — nhấn Tạo lại để thử.";
            font-size: Tokens.font-secondary;
            color: Tokens.danger;
            wrap: word-wrap;
        }

        if summary-state == "idle": Text {
            text: "Chưa có tóm tắt. Bật tự động tóm tắt hoặc nhấn Tạo lại.";
            font-size: Tokens.font-secondary;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }

        if summary-state == "done" && summary-text != "": Text {
            text: summary-text;
            font-size: Tokens.font-secondary;
            color: Tokens.text-primary;
            wrap: word-wrap;
        }
    }
}

/// Full-screen SessionDetail view — header + summary card + scrollable segments.
component SessionDetailView inherits Rectangle {
    // Header metadata
    in property <int>    detail-session-id: 0;
    in property <string> detail-started-at: "";
    in property <string> detail-duration: "";
    in property <string> detail-provider: "";
    // Summary state (forwarded to SessionDetailCard)
    in property <string> detail-summary-text: "";
    in property <string> detail-summary-state: "idle";
    in property <string> detail-error-message: "";
    // Segments list
    in property <[DetailSegmentRow]> detail-segments: [];
    callback back-clicked();
    callback detail-regenerate-clicked(int);
    callback detail-copy-clicked(int);

    background: Tokens.bg;

    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ── Sub-header row ───────────────────────────────────────────────────
        Rectangle {
            height: 52px;
            background: Tokens.surface;

            HorizontalBox {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: start;

                back-touch := TouchArea {
                    width: 36px;
                    clicked => { root.back-clicked(); }
                    Text {
                        text: "←";
                        font-size: 20px;
                        color: back-touch.has-hover ? Tokens.accent : Tokens.text-primary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Phiên #" + detail-session-id + "  ·  " + detail-provider;
                        font-size: Tokens.font-secondary;
                        font-weight: 600;
                        color: Tokens.text-primary;
                        overflow: elide;
                    }
                    Text {
                        text: detail-started-at + "  ·  " + detail-duration;
                        font-size: Tokens.font-caption;
                        color: Tokens.text-secondary;
                        overflow: elide;
                    }
                }
            }

            // Bottom hairline
            Rectangle {
                x: 0; y: parent.height - 1px;
                width: parent.width; height: 1px;
                background: Tokens.border;
            }
        }

        // ── Scrollable content ────────────────────────────────────────────────
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                // Summary card
                SessionDetailCard {
                    summary-text: root.detail-summary-text;
                    summary-state: root.detail-summary-state;
                    error-message: root.detail-error-message;
                    regenerate-clicked => { root.detail-regenerate-clicked(root.detail-session-id); }
                    copy-clicked => { root.detail-copy-clicked(root.detail-session-id); }
                }

                // Segments section header
                HorizontalBox {
                    spacing: 8px;
                    alignment: start;
                    Rectangle {
                        width: 8px; height: 8px; border-radius: 4px;
                        background: Tokens.accent;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "Nội dung phiên  ·  " + detail-segments.length + " đoạn";
                        font-size: Tokens.font-secondary;
                        font-weight: 600;
                        color: Tokens.text-primary;
                        vertical-alignment: center;
                    }
                }

                if detail-segments.length == 0: Text {
                    text: "Chưa có đoạn nào được ghi.";
                    font-size: Tokens.font-secondary;
                    color: Tokens.text-hint;
                    horizontal-alignment: center;
                }

                // Segments list
                VerticalLayout {
                    spacing: 2px;
                    alignment: start;
                    for seg in detail-segments: TranscriptSegmentRow {
                        timestamp: seg.timestamp;
                        speaker: seg.speaker;
                        segment-text: seg.text;
                    }
                }
            }
        }
    }
}

// Round record button — toggles between "tap to record" (gray mic) and
// "recording" (red filled dot pulsing). Sits in a fixed-width column between
// the two transcript panels per user request "ở giữa 2 cột".
component RecordButton inherits Rectangle {
    in property <bool> active;
    callback toggled(bool);

    width: 64px;
    height: 64px;

    touch := TouchArea {
        clicked => {
            root.toggled(!root.active);
        }
    }

    // Outer ring — color reflects state
    Rectangle {
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: root.active
            ? (touch.has-hover ? #ef4444 : #dc2626)
            : (touch.has-hover ? #404040 : #262626);
        border-width: 2px;
        border-color: root.active ? #fca5a5 : Tokens.border;
        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        // Inner dot when recording (small red dot) or mic glyph when idle
        Text {
            text: root.active ? "⏺" : "🎙";
            font-size: 24px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// STT engine / provider picker card for the sidebar.
//
// ── Phase 9: Crash reporting toggle card ─────────────────────────────────────

component CrashReportCard inherits Rectangle {
    // Whether crash reporting is currently enabled (read from consent file at startup).
    in-out property <bool> crash-report-enabled: false;
    // True after the user toggles — shows "restart required" hint.
    in property <bool> show-restart-hint: false;
    // Fired when the toggle changes; Rust writes sentry.txt.
    callback toggled(bool);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Báo cáo lỗi (Sentry)";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Gửi báo cáo crash ẩn danh khi ứng dụng gặp lỗi nghiêm trọng. Không bao gồm nội dung phiên ghi, audio, hay khoá API.";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // Toggle row
        toggle-row := TouchArea {
            height: 36px;
            clicked => {
                root.crash-report-enabled = !root.crash-report-enabled;
                root.toggled(root.crash-report-enabled);
            }
            HorizontalBox {
                spacing: 12px;
                alignment: space-between;

                Text {
                    text: root.crash-report-enabled ? "Đang bật" : "Đang tắt";
                    font-size: Tokens.font-secondary;
                    color: root.crash-report-enabled ? Tokens.success : Tokens.text-hint;
                    vertical-alignment: center;
                }

                // Visual toggle pill
                Rectangle {
                    width: 44px;
                    height: 24px;
                    border-radius: 12px;
                    background: root.crash-report-enabled ? Tokens.accent : #404040;
                    animate background { duration: 150ms; }
                    y: (parent.height - self.height) / 2;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: white;
                        x: root.crash-report-enabled ? parent.width - self.width - 3px : 3px;
                        y: (parent.height - self.height) / 2;
                        animate x { duration: 150ms; easing: ease-in-out; }
                    }
                }
            }
        }

        // Restart-required hint (appears after toggle)
        if show-restart-hint: Text {
            text: "Đã lưu — hiệu lực sau khi khởi động lại Vọng AI Recorder.";
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }
    }
}

// ── Provider card ─────────────────────────────────────────────────────────────
//
// Whisper local is the offline default. Cloud providers (Soniox, OpenAI
// Realtime) give true word-by-word streaming partials but need an API key
// stored in the OS Keychain (BYOK). The save button writes the key via
// `ApiKey::store("<provider>", key)`. Switching provider applies immediately
// via PipelineHandle hot-swap — no restart required.
component ProviderCard inherits Rectangle {
    in property <[string]> provider-options;
    in property <string> current-provider;
    in property <bool> show-api-key;       // true for cloud providers
    in-out property <string> pending-key;
    callback provider-changed(string);
    callback save-key(string, string); // provider-label, key

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "STT engine";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        ComboBox {
            model: provider-options;
            current-value: current-provider;
            selected(value) => {
                root.provider-changed(value);
            }
        }

        // Visible only for cloud providers (Soniox / OpenAI).
        if show-api-key: VerticalLayout {
            spacing: 6px;
            Text {
                text: "API key (lưu vào Keychain):";
                font-size: Tokens.font-caption;
                color: Tokens.text-secondary;
            }
            key-edit := LineEdit {
                placeholder-text: "paste sk-…";
                input-type: password;
                text <=> pending-key;
            }
            save-touch := TouchArea {
                height: 28px;
                clicked => {
                    root.save-key(current-provider, key-edit.text);
                    key-edit.text = "";
                }
                Rectangle {
                    background: save-touch.has-hover ? Tokens.accent : #6d3fe0;
                    border-radius: 4px;
                    animate background { duration: 100ms; }
                    Text {
                        text: "💾  Lưu key";
                        font-size: Tokens.font-caption;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Language picker card for the sidebar. Two ComboBoxes side by side.
// Source = "Bản gốc" language hint for Pass A. Target = mode for Pass B.
component LanguagePickerCard inherits Rectangle {
    in property <[string]> source-options;
    in property <string> current-source;
    in property <[string]> target-options;
    in property <string> current-target;
    callback source-changed(string);
    callback target-changed(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Ngôn ngữ";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Bản gốc (nguồn):";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
        }
        ComboBox {
            model: source-options;
            current-value: current-source;
            selected(value) => {
                root.source-changed(value);
            }
        }

        Text {
            text: "Bản dịch (đích):";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
        }
        ComboBox {
            model: target-options;
            current-value: current-target;
            selected(value) => {
                root.target-changed(value);
            }
        }
    }
}

// Single-column scrolling transcript panel. Used twice in AppWindow body:
// once for "Bản gốc" (use-original = true) and once for "Bản phiên âm"
// (use-original = false). Each instance owns its own ScrollView so the
// two panels scroll independently.
//
// Pass A (Whisper auto-detect) populates `original-text` / `original-lang`
// immediately when an utterance is decoded. Pass B (with language hint)
// fills `text` / `lang` later — when text is empty the right panel shows
// a "đang dịch…" placeholder so users see translation work in flight.
component TranscriptColumn inherits Rectangle {
    in property <[TranscriptLine]> lines;
    in property <string> title;
    in property <bool> use-original;
    in property <color> accent-color: Tokens.accent;
    // Per-corner radius overrides — caller sets the inner-bottom corner large
    // (e.g. 40 px) so the bottom edge curves heavily toward the round mic
    // button sitting between the two columns. Outer corners stay at 8 px.
    in property <length> radius-bl: 8px;
    in property <length> radius-br: 8px;

    background: Tokens.surface;
    border-radius: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: radius-bl;
    border-bottom-right-radius: radius-br;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        // Header — colored dot + title + line counter
        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: accent-color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: title + "  ·  " + lines.length + " dòng";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        // Scrollable list. min-height keeps empty state visible.
        ScrollView {
            min-height: 200px;
            VerticalLayout {
                spacing: 4px;
                alignment: lines.length == 0 ? center : start;

                if lines.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "🎙";
                        font-size: 48px;
                        horizontal-alignment: center;
                        color: Tokens.text-hint;
                    }
                    Text {
                        text: "Đang chờ giọng nói…";
                        font-size: Tokens.font-h2;
                        font-weight: 600;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: use-original
                            ? "Whisper auto-detect sẽ điền cột này ngay\nkhi mỗi utterance được nhận diện."
                            : "Whisper với gợi ý tiếng Việt điền cột này\nsau khi pass đầu hoàn tất.";
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                for line in lines: HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    padding: 4px;

                    // Time gutter
                    Text {
                        text: line.time;
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        vertical-alignment: top;
                        width: 48px;
                    }

                    // Language badge — for translation column, blank until pass B
                    // labels it so we don't show a stale "vi" before result arrives.
                    Text {
                        text: use-original
                            ? (line.original-lang == "" ? "?" : line.original-lang)
                            : (line.translation-done
                                ? (line.lang == "" ? "?" : line.lang)
                                : "…");
                        font-size: Tokens.font-caption;
                        color: accent-color;
                        font-weight: 600;
                        vertical-alignment: top;
                        width: 28px;
                    }

                    // Main text — wraps to fill remaining width.
                    //
                    // Translation column placeholder logic:
                    //   - !translation-done → "⏳  đang dịch…"  (pass B in flight)
                    //   - translation-done && text == ""   → "(không có)"  (pass B done, empty)
                    //   - translation-done && text != ""   → text          (normal)
                    //
                    // Original column placeholder logic:
                    //   - original-text == "" → "(im lặng)"
                    //   - otherwise          → original-text
                    Text {
                        text: use-original
                            ? (line.original-text == "" ? "(im lặng)" : line.original-text)
                            : (line.translation-done
                                ? (line.text == "" ? "(không có)" : line.text)
                                : "⏳  đang dịch…");
                        font-size: Tokens.font-secondary;
                        color: use-original
                            ? (line.original-text == "" ? Tokens.text-hint : Tokens.text-primary)
                            : (line.translation-done && line.text != "" ? Tokens.text-primary : Tokens.text-hint);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

// Single tab button in the Settings sub-sidebar. Highlights when selected.
component SettingsTabButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> tab-id;
    in property <string> current-tab;
    callback selected();

    height: 40px;
    background: tab-id == current-tab
        ? Tokens.surface-hover
        : (touch.has-hover ? #1f1f1f : transparent);
    border-radius: 6px;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { selected(); }
    }

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        Text {
            text: icon;
            font-size: 16px;
            vertical-alignment: center;
            width: 22px;
        }
        Text {
            text: label;
            font-size: Tokens.font-secondary;
            font-weight: tab-id == current-tab ? 600 : 400;
            color: tab-id == current-tab ? Tokens.text-primary : Tokens.text-secondary;
            vertical-alignment: center;
        }
    }
}

// Generic empty-state for tabs we haven't built out yet.
component SettingsPlaceholder inherits Rectangle {
    in property <string> tab-name;
    in property <string> icon;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: icon;
            font-size: 48px;
            horizontal-alignment: center;
            color: Tokens.text-hint;
        }
        Text {
            text: tab-name;
            font-size: Tokens.font-h2;
            font-weight: 700;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
        }
        Text {
            text: "Tính năng sẽ có ở bản kế tiếp.";
            font-size: Tokens.font-secondary;
            color: Tokens.text-hint;
            horizontal-alignment: center;
        }
    }
}

// Full-screen Settings view: sub-sidebar (240 px) with 6 tabs +
// content area on the right. The active tab string is `current-tab`;
// the content area conditionally renders one of the tab components.
//
// `*-card` properties hand the existing config cards (audio source,
// provider, language) down so the settings tabs reuse them — no
// duplication, just relocation from the main sidebar.

// ── Phase 7: Recording settings — VAD sliders + Whisper model picker ────────

/// Entry in the Whisper model picker — one row per ggml-*.bin file on disk.
export struct WhisperModelEntry {
    name: string,          // "ggml-base.bin"
    size-label: string,    // "142 MB"
    is-active: bool,       // true = currently loaded
}

/// One row in VadSlidersCard: label / slider / value readout / reset button.
component VadSliderRow inherits Rectangle {
    in property <string> label;
    in property <float>  slider-value;
    in property <float>  min-val;
    in property <float>  max-val;
    in property <string> display-value;
    callback changed(float);
    callback reset();

    height: 36px;
    background: transparent;

    HorizontalBox {
        spacing: 8px;
        alignment: start;

        Text {
            text: root.label;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            width: 120px;
            vertical-alignment: center;
            overflow: elide;
        }

        slider := Slider {
            horizontal-stretch: 1;
            minimum: root.min-val;
            maximum: root.max-val;
            value: root.slider-value;
            changed(v) => { root.changed(v); }
        }

        Text {
            text: root.display-value;
            font-size: Tokens.font-caption;
            color: Tokens.text-primary;
            width: 52px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        reset-btn := TouchArea {
            width: 28px;
            height: 28px;
            clicked => { root.reset(); }
            Rectangle {
                background: reset-btn.has-hover ? Tokens.surface-hover : transparent;
                border-radius: 4px;
                animate background { duration: 80ms; }
                Text {
                    text: "↺";
                    font-size: Tokens.font-secondary;
                    color: reset-btn.has-hover ? Tokens.accent : Tokens.text-hint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    animate color { duration: 80ms; }
                }
            }
        }
    }
}

/// Card: three VAD sensitivity sliders with live-apply + reset-to-default.
component VadSlidersCard inherits Rectangle {
    in-out property <float> threshold: 0.65;
    in-out property <int>   hangover-ms: 200;
    in-out property <int>   max-duration-ms: 8000;
    callback changed(float, int, int);
    callback reset-threshold();
    callback reset-hangover();
    callback reset-max-duration();

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Voice Activity Detection";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        VadSliderRow {
            label: "Ngưỡng (threshold)";
            slider-value: root.threshold;
            min-val: 0.30;
            max-val: 0.95;
            display-value: round(root.threshold * 100) / 100 + "";
            changed(v) => {
                root.threshold = round(v * 20.0) / 20.0;
                root.changed(root.threshold, root.hangover-ms, root.max-duration-ms);
            }
            reset => { root.reset-threshold(); }
        }

        VadSliderRow {
            label: "Hangover (ms)";
            slider-value: root.hangover-ms;
            min-val: 100;
            max-val: 800;
            display-value: root.hangover-ms + " ms";
            changed(v) => {
                root.hangover-ms = round(v / 50) * 50;
                root.changed(root.threshold, root.hangover-ms, root.max-duration-ms);
            }
            reset => { root.reset-hangover(); }
        }

        VadSliderRow {
            label: "Tối đa (ms)";
            slider-value: root.max-duration-ms;
            min-val: 3000;
            max-val: 15000;
            display-value: root.max-duration-ms / 1000 + " s";
            changed(v) => {
                root.max-duration-ms = round(v / 1000) * 1000;
                root.changed(root.threshold, root.hangover-ms, root.max-duration-ms);
            }
            reset => { root.reset-max-duration(); }
        }

        Text {
            text: "partial-emit và frame-size là hằng số giao thức — không điều chỉnh được.";
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }
    }
}

/// Card: Whisper model picker for LocalWhisper provider.
/// Hidden (replaced by a hint) when the active provider is Soniox/OpenAI.
///
/// Phase 13: clicking Switch now emits `request-model-switch-confirm(name)`
/// instead of `switch-clicked` directly. Rust opens a Dialog; on confirm it
/// calls `switch-clicked` to run the actual swap. This keeps the card decoupled
/// from the Dialog infrastructure.
component WhisperModelCard inherits Rectangle {
    in property <[WhisperModelEntry]> entries;
    in property <string>              active;
    in property <bool>                switch-in-flight: false;
    in property <string>              switch-status: "";
    in property <bool>                provider-is-local-whisper: true;
    /// Emitted when user clicks Switch — Rust opens Dialog before proceeding.
    callback request-model-switch-confirm(string);
    /// Emitted by Rust after dialog confirm — runs the actual swap.
    callback switch-clicked(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Mô hình Whisper";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        if !root.provider-is-local-whisper: Text {
            text: "Chỉ áp dụng cho Whisper cục bộ — đang dùng cloud provider.";
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }

        if root.provider-is-local-whisper && root.entries.length == 0: Text {
            text: "Chưa tìm thấy file mô hình. Tải về qua wizard hoặc đặt file vào thư mục models/.";
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }

        if root.provider-is-local-whisper: VerticalLayout {
            spacing: 4px;

            for entry in root.entries: Rectangle {
                background: entry.is-active ? #1e1333 : Tokens.surface-hover;
                border-radius: 6px;
                border-width: entry.is-active ? 1px : 0px;
                border-color: Tokens.accent;
                height: 40px;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: entry.name;
                            font-size: Tokens.font-secondary;
                            color: entry.is-active ? Tokens.accent : Tokens.text-primary;
                            vertical-alignment: center;
                            font-weight: entry.is-active ? 600 : 400;
                        }
                        Text {
                            text: entry.size-label;
                            font-size: Tokens.font-caption;
                            color: Tokens.text-hint;
                            vertical-alignment: center;
                        }
                        if entry.is-active: Text {
                            text: "✓ Đã tải";
                            font-size: Tokens.font-caption;
                            color: Tokens.success;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    if !entry.is-active && !root.switch-in-flight: switch-btn := TouchArea {
                        width: 68px;
                        height: 28px;
                        // Phase 13: opens confirm dialog before executing swap.
                        clicked => { root.request-model-switch-confirm(entry.name); }
                        Rectangle {
                            background: switch-btn.has-hover ? Tokens.accent : #6d3fe0;
                            border-radius: 4px;
                            animate background { duration: 100ms; }
                            Text {
                                text: "Switch";
                                font-size: Tokens.font-caption;
                                font-weight: 600;
                                color: white;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if root.switch-in-flight: Text {
                        text: "⏳";
                        font-size: Tokens.font-secondary;
                        color: Tokens.text-hint;
                        vertical-alignment: center;
                        width: 68px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if root.switch-in-flight: Text {
            text: "Đang tải mô hình…";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
        }

        if root.switch-status != "": Text {
            text: root.switch-status;
            font-size: Tokens.font-caption;
            color: root.switch-status == "Đang tải mô hình…" ? Tokens.text-secondary : Tokens.danger;
            wrap: word-wrap;
        }
    }
}

// ── Phase 10: Auto-summary card for Settings → System tab ────────────────

/// Card: auto-summary toggle with privacy disclosure.
/// Placed BELOW Phase 9's CrashReportCard in the System tab VerticalLayout.
component AutoSummaryCard inherits Rectangle {
    in property <bool> auto-summary-enabled: false;
    in property <bool> auto-summary-has-key: false;
    callback auto-summary-toggled(bool);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 10px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Tóm tắt phiên (AI)";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: space-between;

            Text {
                text: "Tự động tóm tắt sau khi dừng ghi âm";
                font-size: Tokens.font-caption;
                color: root.auto-summary-has-key ? Tokens.text-primary : Tokens.text-hint;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            toggle-area := TouchArea {
                width: 44px;
                height: 24px;
                enabled: root.auto-summary-has-key;
                clicked => {
                    if root.auto-summary-has-key {
                        root.auto-summary-toggled(!root.auto-summary-enabled);
                    }
                }
                Rectangle {
                    background: root.auto-summary-enabled && root.auto-summary-has-key
                        ? Tokens.accent : Tokens.border;
                    border-radius: 12px;
                    animate background { duration: 150ms; }
                    Rectangle {
                        x: root.auto-summary-enabled && root.auto-summary-has-key
                            ? parent.width - self.width - 2px : 2px;
                        y: 2px;
                        width: 20px; height: 20px; border-radius: 10px;
                        background: white;
                        animate x { duration: 150ms; }
                    }
                }
            }
        }

        Text {
            text: "Sử dụng gpt-4o-mini · ~3-8 giây · ~$0.0006/phiên 30 phút";
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
            wrap: word-wrap;
        }

        if !root.auto-summary-has-key: Text {
            text: "Cấu hình API key OpenAI trong Cài đặt → System để bật tóm tắt.";
            font-size: Tokens.font-caption;
            color: Tokens.danger;
            wrap: word-wrap;
        }

        Rectangle {
            background: #1a0f2e;
            border-radius: 6px;
            border-width: 1px;
            border-color: #3d2472;

            VerticalBox {
                padding: 10px;
                spacing: 4px;
                Text {
                    text: "Quyền riêng tư";
                    font-size: Tokens.font-caption;
                    font-weight: 600;
                    color: #c4b5fd;
                }
                Text {
                    text: "Tự động tóm tắt sẽ gửi nội dung phiên ghi sang OpenAI để tạo tóm tắt. Khoá API của bạn được dùng cho cuộc gọi này. Không bật nếu nội dung phiên là nhạy cảm.";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-secondary;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ── Phase 8: Dictionary entry view-model ─────────────────────────────────
// One row in the dictionary list. Index is the 0-based position used by callbacks.
struct DictionaryEntryRow {
    phrase: string,
    context: string,   // "common" | "names" | "technical"
    index: int,
}

// ── Phase 8: DictionaryCard component ────────────────────────────────────
component DictionaryCard inherits Rectangle {
    // Data
    in property <[DictionaryEntryRow]> entries;
    in property <int> entry-count: 0;
    in property <string> add-error: "";
    in property <bool> show-restart-hint: false;

    // "Add entry" form
    in-out property <string> pending-phrase: "";
    in-out property <string> pending-context: "common";

    // Callbacks fired to Rust
    callback add(string, string);
    callback delete(int);
    callback edit(int, string, string);
    callback move-up(int);
    callback move-down(int);
    callback clear-error();

    background: transparent;

    VerticalLayout {
        spacing: 12px;
        padding: 0px;
        alignment: start;

        // ── Header: title + count ────────────────────────────────────────────
        HorizontalBox {
            alignment: space-between;
            Text {
                text: "Từ điển tùy chỉnh";
                font-size: Tokens.font-h2;
                font-weight: 700;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
            Text {
                text: entry-count + " / 100";
                font-size: Tokens.font-secondary;
                color: entry-count >= 100 ? Tokens.danger : Tokens.text-hint;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Thêm thuật ngữ chuyên ngành, tên riêng, viết tắt để STT nhận diện chính xác hơn.";
            font-size: Tokens.font-secondary;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // ── Restart hint (Soniox / OpenAI only) ──────────────────────────────
        if root.show-restart-hint: Rectangle {
            background: #1e1333;
            border-radius: 6px;
            border-width: 1px;
            border-color: Tokens.accent;
            height: 36px;
            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                alignment: center;
                Text {
                    text: "Áp dụng từ phiên ghi âm tiếp theo (cần khởi động lại Vọng cho Soniox / OpenAI).";
                    font-size: Tokens.font-caption;
                    color: Tokens.accent;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        // ── Add-entry form ────────────────────────────────────────────────────
        Rectangle {
            background: Tokens.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tokens.border;
            height: 52px;

            HorizontalBox {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: stretch;

                phrase-input := LineEdit {
                    placeholder-text: "Thêm thuật ngữ…";
                    text <=> root.pending-phrase;
                    horizontal-stretch: 1;
                    accepted => {
                        if root.pending-phrase != "" {
                            root.add(root.pending-phrase, root.pending-context);
                            root.pending-phrase = "";
                        }
                    }
                }

                ctx-combo := ComboBox {
                    model: ["Chung", "Tên riêng", "Chuyên ngành"];
                    current-value: root.pending-context == "names" ? "Tên riêng"
                                 : root.pending-context == "technical" ? "Chuyên ngành"
                                 : "Chung";
                    width: 120px;
                    selected(v) => {
                        root.pending-context = v == "Tên riêng" ? "names"
                                             : v == "Chuyên ngành" ? "technical"
                                             : "common";
                    }
                }

                add-btn := TouchArea {
                    width: 80px;
                    height: 32px;
                    enabled: entry-count < 100 && root.pending-phrase != "";
                    clicked => {
                        if root.pending-phrase != "" {
                            root.add(root.pending-phrase, root.pending-context);
                            root.pending-phrase = "";
                        }
                    }
                    Rectangle {
                        background: add-btn.enabled
                            ? (add-btn.has-hover ? Tokens.accent : #7c3aed)
                            : Tokens.border;
                        border-radius: 6px;
                        width: parent.width;
                        height: parent.height;
                        Text {
                            text: "+ Thêm";
                            font-size: Tokens.font-secondary;
                            font-weight: 600;
                            color: add-btn.enabled ? Tokens.text-primary : Tokens.text-hint;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // ── Inline validation error ───────────────────────────────────────────
        if root.add-error != "": HorizontalBox {
            spacing: 8px;
            Text {
                text: root.add-error;
                font-size: Tokens.font-caption;
                color: Tokens.danger;
                vertical-alignment: center;
            }
            TouchArea {
                width: 16px;
                height: 16px;
                clicked => { root.clear-error(); }
                Text {
                    text: "✕";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ── Empty-state illustration ──────────────────────────────────────────
        if root.entry-count == 0: Rectangle {
            background: Tokens.surface;
            border-radius: 8px;
            border-width: 1px;
            border-color: Tokens.border;
            height: 80px;
            Text {
                text: "Chưa có từ vựng nào — thêm thuật ngữ chuyên ngành để Whisper / Soniox nhận diện chính xác hơn.";
                font-size: Tokens.font-secondary;
                color: Tokens.text-hint;
                horizontal-alignment: center;
                vertical-alignment: center;
                wrap: word-wrap;
            }
        }

        // ── Entry list ────────────────────────────────────────────────────────
        if root.entry-count > 0: VerticalLayout {
            spacing: 4px;

            for row in root.entries: Rectangle {
                background: Tokens.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Tokens.border;
                height: 44px;

                HorizontalBox {
                    padding-left: 12px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    // Phrase text
                    Text {
                        text: row.phrase;
                        font-size: Tokens.font-secondary;
                        color: Tokens.text-primary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    // Context badge
                    Rectangle {
                        background: row.context == "names" ? #1a3a2a
                                  : row.context == "technical" ? #1a1a3a
                                  : #2a1a3a;
                        border-radius: 4px;
                        width: 80px;
                        height: 22px;
                        Text {
                            text: row.context == "names" ? "Tên riêng"
                                : row.context == "technical" ? "Chuyên ngành"
                                : "Chung";
                            font-size: 10px;
                            color: row.context == "names" ? Tokens.success
                                 : row.context == "technical" ? #8899ff
                                 : Tokens.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            font-weight: 600;
                        }
                    }

                    // Up / Down / Delete buttons
                    HorizontalBox {
                        spacing: 2px;
                        alignment: end;

                        up-btn := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.move-up(row.index); }
                            Rectangle {
                                background: up-btn.has-hover ? Tokens.surface-hover : transparent;
                                border-radius: 4px;
                                width: parent.width;
                                height: parent.height;
                                Text {
                                    text: "↑";
                                    font-size: 14px;
                                    color: Tokens.text-hint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        down-btn := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.move-down(row.index); }
                            Rectangle {
                                background: down-btn.has-hover ? Tokens.surface-hover : transparent;
                                border-radius: 4px;
                                width: parent.width;
                                height: parent.height;
                                Text {
                                    text: "↓";
                                    font-size: 14px;
                                    color: Tokens.text-hint;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        del-btn := TouchArea {
                            width: 28px;
                            height: 28px;
                            clicked => { root.delete(row.index); }
                            Rectangle {
                                background: del-btn.has-hover ? #3a1a1a : transparent;
                                border-radius: 4px;
                                width: parent.width;
                                height: parent.height;
                                Text {
                                    text: "🗑";
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component SettingsScreen inherits Rectangle {
    in-out property <string> current-tab;

    // ─ Audio-source card props
    in property <[string]> audio-sources;
    in property <string> current-audio-source;
    in property <bool> restart-needed;
    callback audio-source-changed(string);

    // ─ Provider card props
    in property <[string]> provider-options;
    in property <string> current-provider;
    in property <bool> provider-is-cloud;
    in-out property <string> pending-api-key;
    callback provider-changed(string);
    callback save-provider-key(string, string);

    // ─ Language card props
    in property <[string]> source-language-options;
    in property <string> current-source-language;
    in property <[string]> target-mode-options;
    in property <string> current-target-mode;
    callback source-language-changed(string);
    callback target-mode-changed(string);

    // ─ Phase 7: VAD sliders
    in-out property <float> vad-threshold: 0.65;
    in-out property <int>   vad-hangover-ms: 200;
    in-out property <int>   vad-max-duration-ms: 8000;
    callback vad-changed(float, int, int);
    callback vad-reset-threshold();
    callback vad-reset-hangover();
    callback vad-reset-max-duration();

    // ─ Phase 7: Whisper model picker
    in property <[WhisperModelEntry]> whisper-models: [];
    in property <string>  active-whisper-model: "";
    in property <bool>    model-switch-in-flight: false;
    in property <string>  model-switch-status: "";
    /// Phase 13: fires confirm request; Rust wraps with Dialog before swap.
    callback request-whisper-model-switch-confirm(string);
    callback whisper-model-switch-clicked(string);

    // ─ Phase 8: Dictionary custom vocabulary
    in property <[DictionaryEntryRow]> dictionary-rows: [];
    in property <int>    dictionary-entry-count: 0;
    in-out property <string> dictionary-pending-phrase: "";
    in-out property <string> dictionary-pending-context: "common";
    in property <string> dictionary-add-error: "";
    in property <bool>   dictionary-show-restart-hint: false;
    callback dictionary-add(string, string);
    callback dictionary-delete(int);
    callback dictionary-edit(int, string, string);
    callback dictionary-move-up(int);
    callback dictionary-move-down(int);
    callback dictionary-clear-error();

    // ─ Phase 9: Crash reporting (Sentry)
    in-out property <bool> crash-report-enabled: false;
    in property <bool>     crash-report-restart-hint: false;
    callback crash-reporting-toggled(bool);

    // ─ Phase 10: Auto-summary
    in property <bool> auto-summary-enabled: false;
    in property <bool> auto-summary-has-key: false;
    callback auto-summary-toggled(bool);
    callback summary-regenerate-clicked(int);

    background: Tokens.bg;

    HorizontalBox {
        spacing: 0;
        padding: 0;
        vertical-stretch: 1;

        // ─── Tab sidebar ───
        Rectangle {
            width: 240px;
            background: #0d0d0d;

            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Tokens.border;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;

                SettingsTabButton {
                    icon: "⚙";  label: "System";        tab-id: "system";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "system"; }
                }
                SettingsTabButton {
                    icon: "⌨";  label: "Voice Typing";  tab-id: "voice-typing";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "voice-typing"; }
                }
                SettingsTabButton {
                    icon: "🎙";  label: "Recording";     tab-id: "recording";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "recording"; }
                }
                SettingsTabButton {
                    icon: "🌐";  label: "Language";      tab-id: "language";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "language"; }
                }
                SettingsTabButton {
                    icon: "📖";  label: "Dictionary";    tab-id: "dictionary";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "dictionary"; }
                }
                SettingsTabButton {
                    icon: "🔔";  label: "Notification";  tab-id: "notification";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "notification"; }
                }
            }
        }

        // ─── Content area ───
        Rectangle {
            background: Tokens.bg;
            horizontal-stretch: 1;

            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;

                    if root.current-tab == "system": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "System";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "STT engine + thông tin ứng dụng";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        ProviderCard {
                            provider-options: root.provider-options;
                            current-provider: root.current-provider;
                            show-api-key: root.provider-is-cloud;
                            pending-key <=> root.pending-api-key;
                            provider-changed(v) => { root.provider-changed(v); }
                            save-key(p, k) => { root.save-provider-key(p, k); }
                        }

                        // ── Phase 9: Crash reporting (Sentry) ──────────────
                        CrashReportCard {
                            crash-report-enabled <=> root.crash-report-enabled;
                            show-restart-hint: root.crash-report-restart-hint;
                            toggled(v) => { root.crash-reporting-toggled(v); }
                        }
                        // ── end Phase 9 ─────────────────────────────────────

                        // ── Phase 10: Auto-summary (OpenAI) ──────────────────
                        AutoSummaryCard {
                            auto-summary-enabled: root.auto-summary-enabled;
                            auto-summary-has-key: root.auto-summary-has-key;
                            auto-summary-toggled(v) => { root.auto-summary-toggled(v); }
                        }
                        // ── end Phase 10 ─────────────────────────────────────

                        // About card — version + tech stack + license
                        Rectangle {
                            background: Tokens.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Tokens.border;

                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;

                                HorizontalBox {
                                    spacing: 8px;
                                    alignment: start;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Tokens.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "About Vọng AI Recorder";
                                        font-size: Tokens.font-secondary;
                                        font-weight: 600;
                                        color: Tokens.text-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Version: 0.1.0-alpha.1";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "Built with Rust · Slint · whisper.cpp · Vulkan · cpal";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "License: AGPL-3.0-only · Privacy-first · BYOK";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "Hotkey: Ctrl + Shift + R  (toggle main window)";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-hint;
                                }
                            }
                        }
                    }

                    if root.current-tab == "voice-typing": SettingsPlaceholder {
                        tab-name: "Voice Typing";
                        icon: "⌨";
                        min-height: 320px;
                    }

                    if root.current-tab == "recording": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Recording";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "Nguồn âm thanh, VAD, mô hình Whisper";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        AudioSourceCard {
                            sources: root.audio-sources;
                            current: root.current-audio-source;
                            restart-needed: root.restart-needed;
                            selected(v) => { root.audio-source-changed(v); }
                        }
                        VadSlidersCard {
                            threshold <=> root.vad-threshold;
                            hangover-ms <=> root.vad-hangover-ms;
                            max-duration-ms <=> root.vad-max-duration-ms;
                            changed(t, h, m) => { root.vad-changed(t, h, m); }
                            reset-threshold => { root.vad-reset-threshold(); }
                            reset-hangover => { root.vad-reset-hangover(); }
                            reset-max-duration => { root.vad-reset-max-duration(); }
                        }
                        WhisperModelCard {
                            entries: root.whisper-models;
                            active: root.active-whisper-model;
                            switch-in-flight: root.model-switch-in-flight;
                            switch-status: root.model-switch-status;
                            provider-is-local-whisper: !root.provider-is-cloud;
                            // Phase 13: confirm-first path.
                            request-model-switch-confirm(name) => {
                                root.request-whisper-model-switch-confirm(name);
                            }
                            switch-clicked(name) => { root.whisper-model-switch-clicked(name); }
                        }
                    }

                    if root.current-tab == "language": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Language";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "Ngôn ngữ nguồn (Bản gốc) + đích (Bản dịch)";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        LanguagePickerCard {
                            source-options: root.source-language-options;
                            current-source: root.current-source-language;
                            target-options: root.target-mode-options;
                            current-target: root.current-target-mode;
                            source-changed(v) => { root.source-language-changed(v); }
                            target-changed(v) => { root.target-mode-changed(v); }
                        }
                    }

                    if root.current-tab == "dictionary": VerticalLayout {
                        spacing: 0px;
                        DictionaryCard {
                            entries: root.dictionary-rows;
                            entry-count: root.dictionary-entry-count;
                            pending-phrase <=> root.dictionary-pending-phrase;
                            pending-context <=> root.dictionary-pending-context;
                            add-error: root.dictionary-add-error;
                            show-restart-hint: root.dictionary-show-restart-hint;
                            add(p, c) => { root.dictionary-add(p, c); }
                            delete(i) => { root.dictionary-delete(i); }
                            edit(i, p, c) => { root.dictionary-edit(i, p, c); }
                            move-up(i) => { root.dictionary-move-up(i); }
                            move-down(i) => { root.dictionary-move-down(i); }
                            clear-error => { root.dictionary-clear-error(); }
                        }
                    }

                    if root.current-tab == "notification": SettingsPlaceholder {
                        tab-name: "Notification";
                        icon: "🔔";
                        min-height: 320px;
                    }
                }
            }
        }
    }
}

// ── Phase 2: model downloader UI types ────────────────────────────────────

// Progress snapshot pushed from Rust via Arc<Mutex<DownloadProgress>> at 30 Hz.
// Phase 3 wizard mounts ModelDownloadCard and binds its in-properties to these.
export struct DownloadProgress {
    state: string,              // "idle"|"fetching"|"hashing"|"done"|"error"|"cancelled"
    bytes-downloaded: int,      // bytes received so far (truncated to i32; < 2 GB ok for all models)
    total-bytes: int,           // expected size from LFS pointer
    eta-secs: int,              // EMA-smoothed seconds remaining; 0 if unknown
    percent: float,             // 0.0–100.0 pre-computed in Rust
    error-message: string,      // Vietnamese error string; non-empty only when state == "error"
}

// Single model card inside the picker grid.
component ModelCard inherits Rectangle {
    in property <string> name;          // "tiny" | "base" | "small" | "medium"
    in property <string> size-label;    // "148 MB"
    in property <string> speed-desc;    // Vietnamese speed/quality blurb
    in property <bool> recommended;     // shows "Khuyến nghị" badge when true
    in property <bool> selected;
    callback clicked();

    background: selected ? #1e1333 : Tokens.surface;
    border-radius: 8px;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Tokens.accent : Tokens.border;
    animate border-color { duration: 120ms; }
    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    VerticalBox {
        padding: 12px;
        spacing: 4px;

        HorizontalBox {
            spacing: 6px;
            alignment: space-between;
            HorizontalBox {
                spacing: 6px;
                alignment: start;
                Text {
                    text: name;
                    font-size: Tokens.font-body;
                    font-weight: 700;
                    color: selected ? Tokens.text-primary : Tokens.text-secondary;
                    vertical-alignment: center;
                }
                Text {
                    text: size-label;
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    vertical-alignment: center;
                }
            }
            if recommended: Rectangle {
                background: #3b2070;
                border-radius: 4px;
                width: 72px;
                height: 18px;
                Text {
                    text: "Khuyến nghị";
                    font-size: 10px;
                    font-weight: 600;
                    color: Tokens.accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: speed-desc;
            font-size: Tokens.font-caption;
            color: Tokens.text-hint;
        }
    }
}

// Reusable model downloader card.
//
// Usage in Phase 3 wizard (ModelDownloadStep):
//   ModelDownloadCard {
//       progress: root.download-progress;
//       start-download(name) => { root.start-model-download(name); }
//       cancel-download()    => { root.cancel-model-download(); }
//   }
//
// Does NOT auto-mount in MainView — Phase 3 wizard owns that.
// Not exported at top level (no Rust code gen for non-Window components).
component ModelDownloadCard inherits Rectangle {
    // Current download progress snapshot (pushed by Rust 30 Hz timer).
    in property <DownloadProgress> progress;
    // Which model card is currently selected (set on card click).
    in-out property <string> selected-model: "base";
    // Fired when user clicks "Tải xuống". Passes the selected model name.
    callback start-download(string);
    // Fired when user clicks "Hủy".
    callback cancel-download();

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // ── Header ──
        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px; height: 8px; border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Tải model Whisper";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Chọn model phù hợp. Sau khi tải về, model được lưu vào máy và không cần kết nối internet.";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        // ── Model picker (2×2 grid via nested HorizontalBoxes) ──
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                spacing: 6px;
                ModelCard {
                    name: "tiny";
                    size-label: "78 MB";
                    speed-desc: "Nhanh nhất · chính xác thấp";
                    recommended: false;
                    selected: root.selected-model == "tiny";
                    clicked => { root.selected-model = "tiny"; }
                    horizontal-stretch: 1;
                }
                ModelCard {
                    name: "base";
                    size-label: "148 MB";
                    speed-desc: "Cân bằng · khuyến nghị";
                    recommended: true;
                    selected: root.selected-model == "base";
                    clicked => { root.selected-model = "base"; }
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                ModelCard {
                    name: "small";
                    size-label: "488 MB";
                    speed-desc: "Chính xác cao · chậm hơn";
                    recommended: false;
                    selected: root.selected-model == "small";
                    clicked => { root.selected-model = "small"; }
                    horizontal-stretch: 1;
                }
                ModelCard {
                    name: "medium";
                    size-label: "1.5 GB";
                    speed-desc: "Chính xác cao nhất · cần GPU";
                    recommended: false;
                    selected: root.selected-model == "medium";
                    clicked => { root.selected-model = "medium"; }
                    horizontal-stretch: 1;
                }
            }
        }

        // ── Progress section (visible while downloading) ──
        if progress.state == "fetching" || progress.state == "hashing": VerticalLayout {
            spacing: 6px;

            HorizontalBox {
                spacing: 8px;
                alignment: space-between;
                Text {
                    text: progress.state == "hashing"
                        ? "Đang kiểm tra tệp…"
                        : ("Đang tải · " + progress.percent + "%");
                    font-size: Tokens.font-caption;
                    color: Tokens.text-secondary;
                    vertical-alignment: center;
                }
                Text {
                    text: progress.eta-secs > 0 ? ("còn ~" + progress.eta-secs + " s") : "";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    vertical-alignment: center;
                }
            }

            // Progress bar track
            Rectangle {
                height: 6px;
                background: #1f1f1f;
                border-radius: 3px;
                border-width: 1px;
                border-color: Tokens.border;
                clip: true;
                Rectangle {
                    x: 0; y: 0;
                    height: parent.height;
                    border-radius: 3px;
                    background: progress.state == "hashing" ? #FBBF24 : Tokens.accent;
                    width: progress.state == "hashing"
                        ? parent.width
                        : parent.width * (progress.percent / 100.0);
                    animate width { duration: 150ms; easing: ease-out; }
                }
            }
        }

        // ── Done state ──
        if progress.state == "done": HorizontalBox {
            spacing: 8px;
            alignment: start;
            Text { text: "✓"; font-size: 16px; color: Tokens.success; vertical-alignment: center; }
            Text {
                text: "Model đã tải xong — sẵn sàng sử dụng";
                font-size: Tokens.font-secondary;
                color: Tokens.success;
                vertical-alignment: center;
            }
        }

        // ── Error / cancelled state ──
        if progress.state == "error" || progress.state == "cancelled": HorizontalBox {
            spacing: 8px;
            alignment: start;
            Text { text: "⚠"; font-size: 16px; color: Tokens.danger; vertical-alignment: center; }
            Text {
                text: progress.state == "cancelled"
                    ? "Đã hủy tải xuống"
                    : progress.error-message;
                font-size: Tokens.font-secondary;
                color: Tokens.danger;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }

        // ── Action buttons ──
        HorizontalBox {
            spacing: 8px;
            alignment: start;

            if progress.state != "fetching" && progress.state != "hashing": download-btn := TouchArea {
                height: 32px;
                width: 160px;
                clicked => { root.start-download(root.selected-model); }
                Rectangle {
                    background: download-btn.has-hover ? Tokens.accent : #6d3fe0;
                    border-radius: 6px;
                    animate background { duration: 100ms; }
                    Text {
                        text: progress.state == "done" ? "Tải lại" : "Tải xuống";
                        font-size: Tokens.font-secondary;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            if progress.state == "fetching" || progress.state == "hashing": cancel-btn := TouchArea {
                height: 32px;
                width: 80px;
                clicked => { root.cancel-download(); }
                Rectangle {
                    background: cancel-btn.has-hover ? #7f1d1d : #4a1010;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Tokens.danger;
                    animate background { duration: 100ms; }
                    Text {
                        text: "Hủy";
                        font-size: Tokens.font-secondary;
                        font-weight: 600;
                        color: Tokens.danger;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// ── Phase 13: Toast + Dialog infrastructure ──────────────────────────────────

/// View-model for one toast banner entry. Pushed from Rust at 30 Hz.
/// `severity` ∈ "info" | "warn" | "error" — drives background color.
export struct ToastEntry {
    id: int,
    message: string,
    severity: string,
    expires-at-ms: int,
}

/// One floating toast card. Auto-dismissed when `expires-at-ms` passes
/// (the Rust timer prunes expired entries before pushing the model).
/// Manual close via the ✕ button fires `close-clicked(id)`.
component Toast inherits Rectangle {
    in property <ToastEntry> entry;
    callback close-clicked(int);

    background: entry.severity == "error" ? #3a1010
               : entry.severity == "warn"  ? #2a2010
               : #0f2a1a;
    border-radius: 8px;
    border-width: 1px;
    border-color: entry.severity == "error" ? Tokens.danger
                : entry.severity == "warn"  ? #FBBF24
                : Tokens.success;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000066;
    height: 48px;
    width: 320px;

    HorizontalBox {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: space-between;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            horizontal-stretch: 1;

            Text {
                text: entry.severity == "error" ? "✕"
                    : entry.severity == "warn"  ? "⚠"
                    : "✓";
                font-size: 14px;
                color: entry.severity == "error" ? Tokens.danger
                     : entry.severity == "warn"  ? #FBBF24
                     : Tokens.success;
                vertical-alignment: center;
                width: 16px;
            }

            Text {
                text: entry.message;
                font-size: Tokens.font-caption;
                color: Tokens.text-primary;
                vertical-alignment: center;
                wrap: no-wrap;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        close-btn := TouchArea {
            width: 24px;
            height: 24px;
            clicked => { root.close-clicked(root.entry.id); }
            Rectangle {
                background: close-btn.has-hover ? Tokens.surface-hover : transparent;
                border-radius: 4px;
                animate background { duration: 80ms; }
                Text {
                    text: "✕";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

/// Vertical stack of toast cards pinned to the top-right corner of the window.
/// Rendered last in AppWindow so it sits on top of all other content (z-order).
component ToastStack inherits Rectangle {
    in property <[ToastEntry]> toasts: [];
    callback dismiss-toast(int);

    background: transparent;
    // Clip false — toasts should not be clipped by window edges
    clip: false;

    VerticalLayout {
        alignment: start;
        spacing: 6px;
        padding: 16px;

        for t in toasts: Toast {
            entry: t;
            close-clicked(id) => { root.dismiss-toast(id); }
        }
    }
}

/// Full-window modal dialog with a semi-transparent backdrop.
/// Emits `dialog-confirmed()` or `dialog-cancelled()` on user choice.
/// Esc key dismisses as cancel via the backdrop TouchArea.
component Dialog inherits Rectangle {
    in property <bool>   dialog-open: false;
    in property <string> dialog-title: "";
    in property <string> dialog-body: "";
    callback dialog-confirmed();
    callback dialog-cancelled();

    // Full-window backdrop — dims the content behind and blocks input.
    background: dialog-open ? #00000099 : transparent;

    // Only participate in hit-testing when open.
    if dialog-open: backdrop := TouchArea {
        width: parent.width;
        height: parent.height;
        // Clicking the backdrop cancels.
        clicked => { root.dialog-cancelled(); }
    }

    if dialog-open: Rectangle {
        // Center the card.
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 400px;
        height: card-layout.preferred-height + 0px;

        background: #1a1a1a;
        border-radius: 10px;
        border-width: 1px;
        border-color: Tokens.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000bb;

        // Stop click propagation — clicks inside the card should NOT cancel.
        TouchArea {
            width: parent.width;
            height: parent.height;
            // No-op: just consumes the click so backdrop doesn't fire.
        }

        card-layout := VerticalBox {
            padding: 24px;
            spacing: 16px;

            // Title
            Text {
                text: dialog-title;
                font-size: Tokens.font-body;
                font-weight: 700;
                color: Tokens.text-primary;
                wrap: word-wrap;
                horizontal-alignment: left;
            }

            // Body
            Text {
                text: dialog-body;
                font-size: Tokens.font-secondary;
                color: Tokens.text-secondary;
                wrap: word-wrap;
                horizontal-alignment: left;
            }

            // Buttons row — "Huỷ" on left, "Đồng ý" on right
            HorizontalBox {
                spacing: 8px;
                alignment: end;

                cancel-btn := TouchArea {
                    width: 80px;
                    height: 32px;
                    clicked => { root.dialog-cancelled(); }
                    Rectangle {
                        background: cancel-btn.has-hover ? Tokens.surface-hover : Tokens.surface;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Tokens.border;
                        animate background { duration: 80ms; }
                        Text {
                            text: "Huỷ";
                            font-size: Tokens.font-secondary;
                            font-weight: 600;
                            color: Tokens.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                confirm-btn := TouchArea {
                    width: 96px;
                    height: 32px;
                    clicked => { root.dialog-confirmed(); }
                    Rectangle {
                        background: confirm-btn.has-hover ? Tokens.accent : #6d3fe0;
                        border-radius: 6px;
                        animate background { duration: 80ms; }
                        Text {
                            text: "Đồng ý";
                            font-size: Tokens.font-secondary;
                            font-weight: 600;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Vọng AI Recorder";
    // Soniox-style wide layout: sidebar 280 + main ≥ 800 = 1080 minimum
    width: 1280px;
    height: 800px;
    background: Tokens.bg;
    icon: @image-url("../assets/icon-64.png");

    // Driven by Rust at ~30 fps via Slint Timer.
    //   peak-level       — [0.0, 1.0] from vong-audio PeakMeter
    //   audio-status     — device + sample rate, or error if mic unavailable
    //   pipeline-status  — "🔇 Listening…" idle / "🗣 N utterances · …" active
    //   last-transcript  — most recent Whisper Final text (empty until first utterance)
    //   storage-status   — "📝 Session #N · X segments saved" or "📝 In-memory only"
    //   history-status   — legacy plain-text fallback (used when is-searching = true)
    in property <float> peak-level: 0.0;
    in property <string> audio-status: "Khởi tạo microphone…";
    in property <string> pipeline-status: "🔇  Listening…";
    in property <string> last-transcript: "";
    in property <string> storage-status: "📝  Initializing storage…";
    in property <string> history-status: "📜  Đang tải lịch sử…";
    in property <[TranscriptLine]> transcript-lines: [];
    callback search-changed(string);

    // ── Phase 11: HistoryCard VecModel + SessionDetail ────────────────────────
    in property <[HistoryRowData]> history-model: [];
    in property <bool> history-is-searching: false;
    // Callback when user clicks a history row.
    callback history-row-clicked(int);

    // SessionDetail view state (populated when current-view = "session-detail")
    in property <int>    detail-session-id: 0;
    in property <string> detail-started-at: "";
    in property <string> detail-duration: "";
    in property <string> detail-provider: "";
    in property <string> detail-summary-text: "";
    // "idle" | "computing" | "done" | "needs-api-key" | "error"
    in property <string> detail-summary-state: "idle";
    in property <string> detail-error-message: "";
    in property <[DetailSegmentRow]> detail-segments: [];
    // Called when user clicks Regenerate in SessionDetail.
    callback detail-regenerate-clicked(int);
    // Called when user clicks Copy in SessionDetail.
    callback detail-copy-clicked(int);

    // Audio source picker
    in property <[string]> audio-sources;
    in property <string> current-audio-source;
    in property <bool> restart-needed: false;
    callback audio-source-changed(string);

    // Wizard (first-run) — replaced the old OnboardingBanner.
    // Wizard step index (0–6) — mutated by on_wizard_next / on_wizard_back.
    in-out property <int> wizard-step: 0;
    // Provider selected in wizard step 2 (drives branching + ApiKey/Model steps).
    in-out property <string> wizard-provider: "local-whisper";
    // Audio device selected in wizard step 1.
    in-out property <string> wizard-device: "";
    // API key text entered in wizard step 3.
    in-out property <string> wizard-api-key: "";
    // API key test result pushed back from Rust ("" | "ok" | <vi-error-string>).
    in property <string> api-key-test-result: "";
    // True while the WS ping is in flight (disables the test button).
    in property <bool> api-key-testing: false;
    // True when at least one Whisper model file is on disk (enables Next on step 4).
    in property <bool> model-ready: false;
    // Wizard source/target language selections (separate from live config).
    in-out property <string> wizard-source-language: "vi";
    in-out property <string> wizard-target-mode: "Dịch sang tiếng Anh";

    // Wizard navigation callbacks — handled in main.rs.
    callback wizard-next();
    callback wizard-back();
    callback wizard-skip();
    callback wizard-complete();
    callback wizard-test-api-key(string, string);   // (provider, key)
    callback wizard-save-api-key(string, string);   // (provider, key)
    callback wizard-source-changed(string);
    callback wizard-target-changed(string);

    // Export action
    in property <string> export-status: "";
    callback export-clicked();

    // Record toggle — default OFF until user clicks. Set in-out so the
    // button click can flip local state immediately while also notifying Rust.
    in-out property <bool> recording: false;
    callback record-toggled(bool);

    // Language pickers — Source (Bản gốc) + Target mode (Bản dịch)
    in property <[string]> source-language-options;
    in property <string> current-source-language;
    callback source-language-changed(string);
    in property <[string]> target-mode-options;
    in property <string> current-target-mode;
    callback target-mode-changed(string);

    // Provider picker (STT engine: Local Whisper / Soniox / OpenAI)
    in property <[string]> provider-mode-options;
    in property <string> current-provider-mode;
    in property <bool> provider-is-cloud: false;
    in-out property <string> pending-api-key;
    callback provider-mode-changed(string);
    callback save-provider-key(string, string);

    // ── Phase 7: Recording settings — VAD sliders + Whisper model picker ───────
    // VAD slider values — seeded from recording.json at startup.
    in-out property <float>  vad-threshold: 0.65;
    in-out property <int>    vad-hangover-ms: 200;
    in-out property <int>    vad-max-duration-ms: 8000;
    // Emitted when any slider changes. Rust live-applies and debounce-persists.
    callback vad-changed(float, int, int);
    // Reset individual sliders to their default values.
    callback vad-reset-threshold();
    callback vad-reset-hangover();
    callback vad-reset-max-duration();
    // Whisper model picker.
    in property <[WhisperModelEntry]> whisper-models: [];
    in property <string>  active-whisper-model: "";
    in property <bool>    model-switch-in-flight: false;
    in property <string>  model-switch-status: "";
    // Phase 13: user clicked Switch → Rust shows confirm dialog before swapping.
    callback request-whisper-model-switch-confirm(string);
    callback whisper-model-switch-clicked(string);

    // ── Phase 8: Dictionary custom vocabulary ─────────────────────────────────
    in property <[DictionaryEntryRow]> dictionary-rows: [];
    in property <int>    dictionary-entry-count: 0;
    in-out property <string> dictionary-pending-phrase: "";
    in-out property <string> dictionary-pending-context: "common";
    in property <string> dictionary-add-error: "";
    in property <bool>   dictionary-show-restart-hint: false;
    callback dictionary-add(string, string);
    callback dictionary-delete(int);
    callback dictionary-edit(int, string, string);
    callback dictionary-move-up(int);
    callback dictionary-move-down(int);
    callback dictionary-clear-error();

    // ─ Phase 9: Crash reporting (Sentry) ─────────────────────────────────────
    // Initialised from consent file at startup; toggle persists immediately but
    // Sentry only activates on next launch (init happens once at startup).
    in-out property <bool> crash-reporting-enabled: false;
    in property <bool>     crash-reporting-restart-hint: false;
    callback crash-reporting-toggled(bool);

    // ─ Phase 9: Wizard crash-report consent (step 6) ──────────────────────────
    in-out property <bool> wizard-crash-reporting-consent: false;
    callback wizard-crash-reporting-changed(bool);

    // ─ Phase 10: Auto-summary (OpenAI gpt-4o-mini) ───────────────────────────
    in property <bool> auto-summary-enabled: false;
    in property <bool> auto-summary-has-key: false;
    callback auto-summary-toggled(bool);
    callback summary-regenerate-clicked(int);

    // ─ Phase 13: Toast banner stack ──────────────────────────────────────────
    // Rust 30 Hz timer pushes this from ToastQueue::snapshot().
    in property <[ToastEntry]> toast-stack: [];
    // Fired when user clicks ✕ on a toast — Rust calls ToastQueue::dismiss(id).
    callback toast-dismissed(int);

    // ─ Phase 13: Modal confirm dialog ────────────────────────────────────────
    // Driven by DialogQueue::snapshot() in the 30 Hz timer.
    in property <bool>   dialog-open: false;
    in property <string> dialog-title: "";
    in property <string> dialog-body: "";
    // Fired by the confirm/cancel buttons — Rust calls DialogQueue::resolve_*.
    callback dialog-confirmed();
    callback dialog-cancelled();

    // ─ Phase 9: Debug-only test trigger (never compiled in release) ───────────
    // Calling this from a debug build fires tracing::error! + panic! to verify
    // the full Sentry pipeline. In release builds, the callback is never wired.
    callback dev-trigger-sentry-panic();

    // View routing — "main" (transcript + sidebar) vs "settings" (full-screen
    // Soniox-style tabbed settings). The gear icon in HeaderBar flips it.
    in-out property <string> current-view: "main";
    in-out property <string> current-settings-tab: "recording";

    // Model download progress — fed by Rust 30 Hz timer from Arc<Mutex<DownloadProgress>>.
    // Phase 3 wizard binds ModelDownloadCard.progress to this property.
    in property <DownloadProgress> download-progress;
    // Fired by ModelDownloadCard when user clicks "Tải xuống". Arg = model name.
    callback start-model-download(string);
    // Fired by ModelDownloadCard when user clicks "Hủy".
    callback cancel-model-download();

    // Connection status indicator (bottom-left footer dot)
    in property <bool> provider-online: false;
    in property <string> provider-status-label: "Whisper local";

    // ──── Soniox-inspired layout ─────────────────────────────────────
    //   Header bar (compact)
    //   ┌─────────────┬──────────────────────────────────────────────┐
    //   │ Sidebar     │  Main content                                │
    //   │  280 px     │   - Live transcript stream (primary)         │
    //   │             │   - Peak meter + pipeline status (secondary) │
    //   │  • Source   │                                              │
    //   │  • History  │                                              │
    //   │  • Search   │                                              │
    //   │  • Export   │                                              │
    //   └─────────────┴──────────────────────────────────────────────┘
    //   Footer (compact)
    //
    // Hero block + Phase 0 status card removed — Soniox dashboards prioritize
    // the transcript over branding chrome. App branding stays in HeaderBar
    // (logo + "Vọng AI Recorder" text) and footer ("vong-ai-recorder · Privacy-first · BYOK").
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        // ─── Wizard view — full-screen overlay, no HeaderBar ───
        // Uses a Rectangle wrapper so the ModelDownloadCard for step 4 can be
        // overlaid at an absolute position (wizard.slint cannot reference
        // DownloadProgress or ModelDownloadCard defined here).
        if current-view == "wizard": Rectangle {
            vertical-stretch: 1;
            background: transparent;

            WizardOverlay {
                width: parent.width;
                height: parent.height;
                step <=> wizard-step;
                selected-provider <=> wizard-provider;
                selected-device <=> wizard-device;
                audio-devices: audio-sources;
                source-language-options: source-language-options;
                selected-source-language <=> wizard-source-language;
                target-mode-options: target-mode-options;
                selected-target-mode <=> wizard-target-mode;
                api-key-text <=> wizard-api-key;
                api-key-test-result: api-key-test-result;
                api-key-testing: api-key-testing;
                model-ready: model-ready;
                // Phase 9: wizard step 6 crash-report consent
                crash-report-consent <=> wizard-crash-reporting-consent;
                next => { root.wizard-next(); }
                back => { root.wizard-back(); }
                skip => { root.wizard-skip(); }
                complete => { root.wizard-complete(); }
                test-api-key(p, k) => { root.wizard-test-api-key(p, k); }
                save-api-key(p, k) => { root.wizard-save-api-key(p, k); }
                source-language-changed(v) => { root.wizard-source-changed(v); }
                target-mode-changed(v) => { root.wizard-target-changed(v); }
                wizard-crash-reporting-changed(v) => { root.wizard-crash-reporting-changed(v); }
            }

            // Step 4 (Model Download) content injected here — ModelDownloadCard lives
            // in this file; wizard.slint (imported here) cannot reference it back.
            // Positioned below the 56px wizard header + ~180px step title block.
            if wizard-step == 4: Rectangle {
                y: 56px + 190px;
                x: 40px;
                width: parent.width - 80px;
                height: parent.height - 56px - 190px - 72px; // minus header + title + footer
                background: transparent;
                ModelDownloadCard {
                    width: parent.width;
                    progress: download-progress;
                    start-download(name) => { root.start-model-download(name); }
                    cancel-download() => { root.cancel-model-download(); }
                }
            }
        }

        // Header shown only when not in wizard view
        if current-view != "wizard": HeaderBar {
            in-settings: current-view == "settings" || current-view == "session-detail";
            settings-clicked => { root.current-view = "settings"; }
            back-clicked => { root.current-view = "main"; }
        }

        // ─── Session detail view ───
        if current-view == "session-detail": SessionDetailView {
            vertical-stretch: 1;
            detail-session-id: detail-session-id;
            detail-started-at: detail-started-at;
            detail-duration: detail-duration;
            detail-provider: detail-provider;
            detail-summary-text: detail-summary-text;
            detail-summary-state: detail-summary-state;
            detail-error-message: detail-error-message;
            detail-segments: detail-segments;
            back-clicked => { root.current-view = "main"; }
            detail-regenerate-clicked(id) => { root.detail-regenerate-clicked(id); }
            detail-copy-clicked(id) => { root.detail-copy-clicked(id); }
        }

        // ─── Settings view ───
        if current-view == "settings": SettingsScreen {
            current-tab <=> current-settings-tab;
            vertical-stretch: 1;

            audio-sources: audio-sources;
            current-audio-source: current-audio-source;
            restart-needed: restart-needed;
            audio-source-changed(v) => { root.audio-source-changed(v); }

            provider-options: provider-mode-options;
            current-provider: current-provider-mode;
            provider-is-cloud: provider-is-cloud;
            pending-api-key <=> pending-api-key;
            provider-changed(v) => { root.provider-mode-changed(v); }
            save-provider-key(p, k) => { root.save-provider-key(p, k); }

            source-language-options: source-language-options;
            current-source-language: current-source-language;
            target-mode-options: target-mode-options;
            current-target-mode: current-target-mode;
            source-language-changed(v) => { root.source-language-changed(v); }
            target-mode-changed(v) => { root.target-mode-changed(v); }

            vad-threshold <=> vad-threshold;
            vad-hangover-ms <=> vad-hangover-ms;
            vad-max-duration-ms <=> vad-max-duration-ms;
            vad-changed(t, h, m) => { root.vad-changed(t, h, m); }
            vad-reset-threshold => { root.vad-reset-threshold(); }
            vad-reset-hangover => { root.vad-reset-hangover(); }
            vad-reset-max-duration => { root.vad-reset-max-duration(); }

            whisper-models: whisper-models;
            active-whisper-model: active-whisper-model;
            model-switch-in-flight: model-switch-in-flight;
            model-switch-status: model-switch-status;
            request-whisper-model-switch-confirm(name) => {
                root.request-whisper-model-switch-confirm(name);
            }
            whisper-model-switch-clicked(name) => { root.whisper-model-switch-clicked(name); }

            // ── Phase 8: Dictionary
            dictionary-rows: dictionary-rows;
            dictionary-entry-count: dictionary-entry-count;
            dictionary-pending-phrase <=> dictionary-pending-phrase;
            dictionary-pending-context <=> dictionary-pending-context;
            dictionary-add-error: dictionary-add-error;
            dictionary-show-restart-hint: dictionary-show-restart-hint;
            dictionary-add(p, c) => { root.dictionary-add(p, c); }
            dictionary-delete(i) => { root.dictionary-delete(i); }
            dictionary-edit(i, p, c) => { root.dictionary-edit(i, p, c); }
            dictionary-move-up(i) => { root.dictionary-move-up(i); }
            dictionary-move-down(i) => { root.dictionary-move-down(i); }
            dictionary-clear-error => { root.dictionary-clear-error(); }

            // ── Phase 9: Crash reporting
            crash-report-enabled <=> crash-reporting-enabled;
            crash-report-restart-hint: crash-reporting-restart-hint;
            crash-reporting-toggled(v) => { root.crash-reporting-toggled(v); }

            // ── Phase 10: Auto-summary
            auto-summary-enabled: auto-summary-enabled;
            auto-summary-has-key: auto-summary-has-key;
            auto-summary-toggled(v) => { root.auto-summary-toggled(v); }
            summary-regenerate-clicked(id) => { root.summary-regenerate-clicked(id); }
        }

        // ─── Main view: two-column body. Sidebar left, transcript-dominated main right.
        if current-view == "main": HorizontalBox {
            spacing: 0px;
            padding: 0px;

            // Sidebar — fixed 320 px (Soniox uses ~280-320 px), scrollable
            Rectangle {
                width: 320px;
                background: #0d0d0d;  // slightly darker than bg for sidebar separation
                border-width: 0;
                // Right hairline border
                Rectangle {
                    x: parent.width - 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Tokens.border;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: start; // cards size to content, no stretch fill

                        // First-run onboarding handled by WizardOverlay (current-view == "wizard").
                        // OnboardingBanner removed — wizard covers the full window until complete.

                        // Audio source / Provider / Language pickers moved to
                        // the Settings screen (⚙ Header). Sidebar here keeps
                        // only per-session controls (history + export).

                        HistoryCard {
                            history-model: history-model;
                            search-text: history-status;
                            is-searching: history-is-searching;
                            search-changed(q) => { root.search-changed(q); }
                            row-clicked(id) => { root.history-row-clicked(id); }
                        }

                        ExportCard {
                            status: export-status;
                            export-clicked => {
                                root.export-clicked();
                            }
                        }
                    }
                }
            }

            // Main content — two equal-width transcript panels (50/50) above
            // a single peak meter strip. Both panels share the same `lines`
            // model; one renders the auto-detect ("Bản gốc") fields, the other
            // renders the language-hinted ("Bản phiên âm") fields.
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                horizontal-stretch: 1;

                // Stack:  ┌Bản gốc┐  ┌Bản dịch┐
                //          │       │  │        │
                //          ╰───────╯  ╰────────╯
                //                ╲ ◯ ╱
                //              ( Nhấn để ghi )
                //
                // The mic button "joins" the two columns from BELOW, sitting
                // in the gap between them. The columns themselves are normal
                // rounded rectangles — the button visually connects them via
                // its centered horizontal position + a slight upward overlap
                // (`y: -28px`) into the bottom border of both columns.
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    // Row of two transcript columns — fills the WHOLE Rectangle
                    // minus the button cradle reserved at the bottom (60 px).
                    // The button visually overlaps into the columns' bottom
                    // edge (~30 px) so it looks like it "joins" them.
                    HorizontalBox {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - 60px;
                        spacing: 10px;
                        padding: 0px;

                        TranscriptColumn {
                            lines: transcript-lines;
                            title: "Bản gốc";
                            use-original: true;
                            accent-color: #4ADE80; // success green — real-time / first
                            radius-br: 96px; // heavy curve toward the mic button
                            horizontal-stretch: 1;
                        }

                        TranscriptColumn {
                            lines: transcript-lines;
                            title: "Bản dịch";
                            use-original: false;
                            accent-color: Tokens.accent; // violet — translated
                            radius-bl: 96px; // heavy curve toward the mic button
                            horizontal-stretch: 1;
                        }
                    }

                    // Mic button cradle — anchored to the BOTTOM CENTER of
                    // the Rectangle so the round button sits horizontally
                    // centered between the two transcript columns above it.
                    // y starts inside the columns' bottom edge to give the
                    // "nối tiếp" (joining) feel the user asked for.
                    VerticalLayout {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height;
                        width: 160px;
                        height: 96px;
                        alignment: center;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: center;
                            RecordButton {
                                active: recording;
                                toggled(on) => {
                                    root.recording = on;
                                    root.record-toggled(on);
                                }
                            }
                        }
                        Text {
                            text: recording ? "● Đang ghi…  (nhấn để dừng)" : "Nhấn để ghi";
                            font-size: Tokens.font-caption;
                            font-weight: recording ? 700 : 400;
                            color: recording ? Tokens.danger : Tokens.text-hint;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }

                PeakMeter {
                    level: peak-level;
                    status: audio-status;
                    footer: pipeline-status;
                }
            }
        }

        // Footer — bottom-left shows provider connection status (label + dot),
        // bottom-right keeps the app handle.
        Rectangle {
            height: 36px;
            background: Tokens.surface;

            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 16px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: provider-online ? Tokens.success : #555555;
                            border-width: 1px;
                            border-color: provider-online ? #166534 : #333333;
                            y: (parent.height - self.height) / 2;
                            animate background { duration: 200ms; }
                        }
                        Text {
                            text: provider-status-label + (provider-online ? "  ·  online" : "  ·  offline");
                            font-size: Tokens.font-caption;
                            color: provider-online ? Tokens.text-primary : Tokens.text-hint;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Privacy-first · BYOK · Audio never leaves your device";
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "vong-ai-recorder";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    vertical-alignment: center;
                }
            }

            // Top hairline border
            Rectangle {
                x: 0; y: 0;
                width: parent.width; height: 1px;
                background: Tokens.border;
            }
        }
    }

    // ── Phase 13: Toast stack — top-right overlay, above all views ────────────
    // Absolutely positioned so it floats over whatever view is active.
    // Rendered outside the VerticalBox so Slint's z-order puts it on top.
    if toast-stack.length > 0: ToastStack {
        x: parent.width - self.width;
        y: 0;
        width: 352px;   // 320px card + 16px*2 padding
        height: parent.height;
        toasts: toast-stack;
        dismiss-toast(id) => { root.toast-dismissed(id); }
    }

    // ── Phase 13: Modal dialog overlay — above everything including toasts ────
    // Full-window size so backdrop covers the entire window.
    Dialog {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        dialog-open: dialog-open;
        dialog-title: dialog-title;
        dialog-body: dialog-body;
        dialog-confirmed => { root.dialog-confirmed(); }
        dialog-cancelled => { root.dialog-cancelled(); }
    }
}
