// Vọng AI Recorder — main window.
//
// Single AppWindow with sidebar + two transcript columns (Bản gốc / Bản dịch)
// + mic record button between them. The previous floating-pill window was
// removed — too low-signal next to the main UI.
// Design tokens mirror `docs/design.md`.

import { VerticalBox, HorizontalBox, LineEdit, ComboBox, ScrollView } from "std-widgets.slint";

// Soniox-style transcript line — single utterance with timestamp + language tag.
//
// Carries TWO parallel renditions of the same utterance:
//   - `original-text` / `original-lang` — auto-detected ("Bản gốc")
//   - `text` / `lang` — language-hinted decode ("Bản phiên âm")
// UI renders them side-by-side in TranscriptStream.
struct TranscriptLine {
    seq: int,
    time: string,             // "14:30"
    lang: string,              // hinted/primary language, e.g. "vi"
    text: string,              // primary text ("Bản phiên âm")
    original-lang: string,     // auto-detected language, e.g. "en"
    original-text: string,     // auto-detected text ("Bản gốc")
    duration-ms: int,          // for confidence dimming if needed
    translation-done: bool,    // true once pass B has emitted Translation
}

// ---- Design tokens (mirrored from docs/design.md §1.2) ----
// Promote to vong-ui/ui/tokens.slint in Phase 5 and @import there.
global Tokens {
    // Surfaces
    out property <color> bg: #0A0A0A;
    out property <color> surface: #171717;
    out property <color> surface-hover: #262626;
    out property <color> border: #404040;

    // Text
    out property <color> text-primary: #FAFAFA;
    out property <color> text-secondary: #A3A3A3;
    out property <color> text-hint: #737373;

    // Accents
    out property <color> accent: #8B5CF6;        // violet 500
    out property <color> success: #4ADE80;       // green 400
    out property <color> danger: #F87171;        // red 400

    // Typography (px)
    out property <length> font-display: 48px;
    out property <length> font-h1: 28px;
    out property <length> font-h2: 20px;
    out property <length> font-body: 16px;
    out property <length> font-secondary: 14px;
    out property <length> font-caption: 12px;
}

component HeaderBar inherits Rectangle {
    callback settings-clicked();
    callback back-clicked();
    in property <bool> in-settings;

    height: 48px;
    background: Tokens.surface;
    border-width: 0px;
    drop-shadow-blur: 0px;

    HorizontalBox {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        HorizontalBox {
            spacing: 10px;
            alignment: start;

            if in-settings: back-touch := TouchArea {
                width: 32px;
                clicked => { root.back-clicked(); }
                Text {
                    text: "←";
                    font-size: 20px;
                    color: back-touch.has-hover ? Tokens.accent : Tokens.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: in-settings ? "⚙" : "🔊";
                font-size: 18px;
                vertical-alignment: center;
            }
            Text {
                text: in-settings ? "Cài đặt" : "Vọng AI Recorder";
                font-size: Tokens.font-body;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            spacing: 12px;
            alignment: end;

            Text {
                text: "v0.1.0-alpha";
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                vertical-alignment: center;
            }

            if !in-settings: gear-touch := TouchArea {
                width: 32px;
                height: 32px;
                clicked => { root.settings-clicked(); }
                Text {
                    text: "⚙";
                    font-size: 18px;
                    color: gear-touch.has-hover ? Tokens.accent : Tokens.text-secondary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Bottom hairline border
    Rectangle {
        x: 0; y: parent.height - 1px;
        width: parent.width; height: 1px;
        background: Tokens.border;
    }
}

component StatusCard inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <color> dot-color: Tokens.success;

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 6px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            // Status dot
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: dot-color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: title;
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: body;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}

// Compact peak meter strip — Soniox apps put this at bottom-of-main as a
// thin status bar. Status + footer text inline; the peak bar is the
// horizontal accent.
component PeakMeter inherits Rectangle {
    in property <float> level: 0.0;
    in property <string> status;
    in property <string> footer;

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;
    height: 88px;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        HorizontalBox {
            spacing: 16px;
            alignment: space-between;
            Text {
                text: status;
                font-size: Tokens.font-secondary;
                color: Tokens.text-primary;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: footer;
                font-size: Tokens.font-caption;
                color: Tokens.text-hint;
                wrap: no-wrap;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        // Track
        Rectangle {
            height: 6px;
            background: #1f1f1f;
            border-radius: 3px;
            border-width: 1px;
            border-color: Tokens.border;
            clip: true;

            // Fill — width = parent * level. Color thresholds match RMS guidance:
            //   0.0-0.70 green (safe), 0.70-0.90 yellow (warm), >0.90 red (clipping).
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * level;
                height: parent.height;
                border-radius: 3px;
                background: level > 0.9 ? Tokens.danger
                          : level > 0.7 ? #FBBF24
                          : Tokens.success;
                animate width { duration: 80ms; easing: ease-out; }
                animate background { duration: 120ms; }
            }
        }
    }
}

// Onboarding banner — shown only on first launch. Dismissible. Compact intro
// explaining the three killer features. Persists completion state in config.
component OnboardingBanner inherits Rectangle {
    callback dismiss();

    background: #1a1133; // tinted violet for distinction from regular cards
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.accent;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: space-between;

            HorizontalBox {
                spacing: 8px;
                alignment: start;
                Text {
                    text: "👋";
                    font-size: 18px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Chào mừng tới Vọng AI Recorder";
                    font-size: Tokens.font-h2;
                    font-weight: 800;
                    color: Tokens.text-primary;
                    vertical-alignment: center;
                }
            }

            dismiss-touch := TouchArea {
                width: 20px;
                height: 20px;
                clicked => { root.dismiss(); }
                Text {
                    text: "✕";
                    font-size: 14px;
                    color: dismiss-touch.has-hover ? Tokens.text-primary : Tokens.text-hint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            text: "🎙  Ghi mic hoặc loopback từ Speakers (chọn ở mục bên dưới).\n🧠  Whisper Base xử lý local — không gửi audio lên cloud.\n🔎  Tìm bản phiên âm với FTS5 — không dấu vẫn khớp (\"viet\" → \"Việt\").";
            font-size: Tokens.font-secondary;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }

        cta-touch := TouchArea {
            height: 32px;
            clicked => { root.dismiss(); }
            Rectangle {
                background: cta-touch.has-hover ? Tokens.accent : #7c4ce6;
                border-radius: 6px;
                animate background { duration: 100ms; }
                Text {
                    text: "Bắt đầu sử dụng  →";
                    font-size: Tokens.font-secondary;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Audio source picker — enumerates input + output devices. Selecting an output
// captures via WASAPI loopback (Windows system audio). Selection persists to
// config; restart required for the new source to take effect.
component AudioSourceCard inherits Rectangle {
    in property <[string]> sources;
    in property <string> current;
    in property <bool> restart-needed;
    callback selected(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Nguồn âm thanh";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        ComboBox {
            model: sources;
            current-value: current;
            selected(value) => {
                root.selected(value);
            }
        }

        if restart-needed: Text {
            text: "↻  Đã lưu — khởi động lại Vọng AI Recorder để áp dụng";
            font-size: Tokens.font-caption;
            color: Tokens.danger;
            wrap: no-wrap;
        }
    }
}

// Export action card — single button "📥 Xuất Markdown" + status text.
// Exports the most-recent session's segments to `~/Documents/Vong/`.
component ExportCard inherits Rectangle {
    in property <string> status;
    callback export-clicked();

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        btn := TouchArea {
            height: 32px;
            clicked => {
                root.export-clicked();
            }
            Rectangle {
                background: btn.has-hover ? Tokens.accent : #6d3fe0;
                border-radius: 4px;
                animate background { duration: 100ms; }
                Text {
                    text: "📥  Xuất phiên mới nhất → Markdown";
                    font-size: Tokens.font-caption;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Status only appears AFTER a click — gives user feedback without
        // duplicating the button label when idle.
        if status != "": Text {
            text: status;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}

// History + FTS5 search card — when input is empty, `text` holds the recent
// sessions list (refreshed ~1 Hz). When non-empty, Rust runs `search_transcripts`
// against the FTS5 virtual table (Vietnamese tone-insensitive via remove_diacritics=2)
// and `text` holds the formatted hits. Single Slint text node, dual-purpose data.
component HistoryCard inherits Rectangle {
    in property <string> text;
    callback search-changed(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Tìm + Lịch sử";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        LineEdit {
            placeholder-text: "Tìm trong tất cả phiên ghi…";
            edited(t) => {
                root.search-changed(t);
            }
        }

        Text {
            text: text;
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
            wrap: word-wrap;
        }
    }
}

// Round record button — toggles between "tap to record" (gray mic) and
// "recording" (red filled dot pulsing). Sits in a fixed-width column between
// the two transcript panels per user request "ở giữa 2 cột".
component RecordButton inherits Rectangle {
    in property <bool> active;
    callback toggled(bool);

    width: 64px;
    height: 64px;

    touch := TouchArea {
        clicked => {
            root.toggled(!root.active);
        }
    }

    // Outer ring — color reflects state
    Rectangle {
        width: 64px;
        height: 64px;
        border-radius: 32px;
        background: root.active
            ? (touch.has-hover ? #ef4444 : #dc2626)
            : (touch.has-hover ? #404040 : #262626);
        border-width: 2px;
        border-color: root.active ? #fca5a5 : Tokens.border;
        animate background { duration: 150ms; }
        animate border-color { duration: 150ms; }

        // Inner dot when recording (small red dot) or mic glyph when idle
        Text {
            text: root.active ? "⏺" : "🎙";
            font-size: 24px;
            color: white;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// STT engine / provider picker card for the sidebar.
//
// Whisper local is the offline default. Cloud providers (Soniox, OpenAI
// Realtime) give true word-by-word streaming partials but need an API key
// stored in the OS Keychain (BYOK). The save button writes the key via
// `ApiKey::store("<provider>", key)`. Switching provider needs a restart
// to take effect because hot-swapping the running stream task is not
// implemented yet.
component ProviderCard inherits Rectangle {
    in property <[string]> provider-options;
    in property <string> current-provider;
    in property <bool> show-api-key;       // true for cloud providers
    in property <bool> restart-required;
    in-out property <string> pending-key;
    callback provider-changed(string);
    callback save-key(string, string); // provider-label, key

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "STT engine";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        ComboBox {
            model: provider-options;
            current-value: current-provider;
            selected(value) => {
                root.provider-changed(value);
            }
        }

        // Visible only for cloud providers (Soniox / OpenAI).
        if show-api-key: VerticalLayout {
            spacing: 6px;
            Text {
                text: "API key (lưu vào Keychain):";
                font-size: Tokens.font-caption;
                color: Tokens.text-secondary;
            }
            key-edit := LineEdit {
                placeholder-text: "paste sk-…";
                input-type: password;
                text <=> pending-key;
            }
            save-touch := TouchArea {
                height: 28px;
                clicked => {
                    root.save-key(current-provider, key-edit.text);
                    key-edit.text = "";
                }
                Rectangle {
                    background: save-touch.has-hover ? Tokens.accent : #6d3fe0;
                    border-radius: 4px;
                    animate background { duration: 100ms; }
                    Text {
                        text: "💾  Lưu key";
                        font-size: Tokens.font-caption;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        if restart-required: Text {
            text: "↻  Khởi động lại Vọng để áp dụng provider mới";
            font-size: Tokens.font-caption;
            color: Tokens.danger;
            wrap: word-wrap;
        }
    }
}

// Language picker card for the sidebar. Two ComboBoxes side by side.
// Source = "Bản gốc" language hint for Pass A. Target = mode for Pass B.
component LanguagePickerCard inherits Rectangle {
    in property <[string]> source-options;
    in property <string> current-source;
    in property <[string]> target-options;
    in property <string> current-target;
    callback source-changed(string);
    callback target-changed(string);

    background: Tokens.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Tokens.accent;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Ngôn ngữ";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Bản gốc (nguồn):";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
        }
        ComboBox {
            model: source-options;
            current-value: current-source;
            selected(value) => {
                root.source-changed(value);
            }
        }

        Text {
            text: "Bản dịch (đích):";
            font-size: Tokens.font-caption;
            color: Tokens.text-secondary;
        }
        ComboBox {
            model: target-options;
            current-value: current-target;
            selected(value) => {
                root.target-changed(value);
            }
        }
    }
}

// Single-column scrolling transcript panel. Used twice in AppWindow body:
// once for "Bản gốc" (use-original = true) and once for "Bản phiên âm"
// (use-original = false). Each instance owns its own ScrollView so the
// two panels scroll independently.
//
// Pass A (Whisper auto-detect) populates `original-text` / `original-lang`
// immediately when an utterance is decoded. Pass B (with language hint)
// fills `text` / `lang` later — when text is empty the right panel shows
// a "đang dịch…" placeholder so users see translation work in flight.
component TranscriptColumn inherits Rectangle {
    in property <[TranscriptLine]> lines;
    in property <string> title;
    in property <bool> use-original;
    in property <color> accent-color: Tokens.accent;
    // Per-corner radius overrides — caller sets the inner-bottom corner large
    // (e.g. 40 px) so the bottom edge curves heavily toward the round mic
    // button sitting between the two columns. Outer corners stay at 8 px.
    in property <length> radius-bl: 8px;
    in property <length> radius-br: 8px;

    background: Tokens.surface;
    border-radius: 8px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: radius-bl;
    border-bottom-right-radius: radius-br;
    border-width: 1px;
    border-color: Tokens.border;

    VerticalBox {
        padding: 16px;
        spacing: 8px;

        // Header — colored dot + title + line counter
        HorizontalBox {
            spacing: 8px;
            alignment: start;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: accent-color;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: title + "  ·  " + lines.length + " dòng";
                font-size: Tokens.font-secondary;
                font-weight: 600;
                color: Tokens.text-primary;
                vertical-alignment: center;
            }
        }

        // Scrollable list. min-height keeps empty state visible.
        ScrollView {
            min-height: 200px;
            VerticalLayout {
                spacing: 4px;
                alignment: lines.length == 0 ? center : start;

                if lines.length == 0: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: "🎙";
                        font-size: 48px;
                        horizontal-alignment: center;
                        color: Tokens.text-hint;
                    }
                    Text {
                        text: "Đang chờ giọng nói…";
                        font-size: Tokens.font-h2;
                        font-weight: 600;
                        color: Tokens.text-secondary;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: use-original
                            ? "Whisper auto-detect sẽ điền cột này ngay\nkhi mỗi utterance được nhận diện."
                            : "Whisper với gợi ý tiếng Việt điền cột này\nsau khi pass đầu hoàn tất.";
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                for line in lines: HorizontalBox {
                    spacing: 10px;
                    alignment: start;
                    padding: 4px;

                    // Time gutter
                    Text {
                        text: line.time;
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        vertical-alignment: top;
                        width: 48px;
                    }

                    // Language badge — for translation column, blank until pass B
                    // labels it so we don't show a stale "vi" before result arrives.
                    Text {
                        text: use-original
                            ? (line.original-lang == "" ? "?" : line.original-lang)
                            : (line.translation-done
                                ? (line.lang == "" ? "?" : line.lang)
                                : "…");
                        font-size: Tokens.font-caption;
                        color: accent-color;
                        font-weight: 600;
                        vertical-alignment: top;
                        width: 28px;
                    }

                    // Main text — wraps to fill remaining width.
                    //
                    // Translation column placeholder logic:
                    //   - !translation-done → "⏳  đang dịch…"  (pass B in flight)
                    //   - translation-done && text == ""   → "(không có)"  (pass B done, empty)
                    //   - translation-done && text != ""   → text          (normal)
                    //
                    // Original column placeholder logic:
                    //   - original-text == "" → "(im lặng)"
                    //   - otherwise          → original-text
                    Text {
                        text: use-original
                            ? (line.original-text == "" ? "(im lặng)" : line.original-text)
                            : (line.translation-done
                                ? (line.text == "" ? "(không có)" : line.text)
                                : "⏳  đang dịch…");
                        font-size: Tokens.font-secondary;
                        color: use-original
                            ? (line.original-text == "" ? Tokens.text-hint : Tokens.text-primary)
                            : (line.translation-done && line.text != "" ? Tokens.text-primary : Tokens.text-hint);
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
    }
}

// Single tab button in the Settings sub-sidebar. Highlights when selected.
component SettingsTabButton inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <string> tab-id;
    in property <string> current-tab;
    callback selected();

    height: 40px;
    background: tab-id == current-tab
        ? Tokens.surface-hover
        : (touch.has-hover ? #1f1f1f : transparent);
    border-radius: 6px;
    animate background { duration: 100ms; }

    touch := TouchArea {
        clicked => { selected(); }
    }

    HorizontalBox {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: start;

        Text {
            text: icon;
            font-size: 16px;
            vertical-alignment: center;
            width: 22px;
        }
        Text {
            text: label;
            font-size: Tokens.font-secondary;
            font-weight: tab-id == current-tab ? 600 : 400;
            color: tab-id == current-tab ? Tokens.text-primary : Tokens.text-secondary;
            vertical-alignment: center;
        }
    }
}

// Generic empty-state for tabs we haven't built out yet.
component SettingsPlaceholder inherits Rectangle {
    in property <string> tab-name;
    in property <string> icon;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: icon;
            font-size: 48px;
            horizontal-alignment: center;
            color: Tokens.text-hint;
        }
        Text {
            text: tab-name;
            font-size: Tokens.font-h2;
            font-weight: 700;
            color: Tokens.text-secondary;
            horizontal-alignment: center;
        }
        Text {
            text: "Tính năng sẽ có ở bản kế tiếp.";
            font-size: Tokens.font-secondary;
            color: Tokens.text-hint;
            horizontal-alignment: center;
        }
    }
}

// Full-screen Settings view: sub-sidebar (240 px) with 6 tabs +
// content area on the right. The active tab string is `current-tab`;
// the content area conditionally renders one of the tab components.
//
// `*-card` properties hand the existing config cards (audio source,
// provider, language) down so the settings tabs reuse them — no
// duplication, just relocation from the main sidebar.
component SettingsScreen inherits Rectangle {
    in-out property <string> current-tab;

    // ─ Audio-source card props
    in property <[string]> audio-sources;
    in property <string> current-audio-source;
    in property <bool> restart-needed;
    callback audio-source-changed(string);

    // ─ Provider card props
    in property <[string]> provider-options;
    in property <string> current-provider;
    in property <bool> provider-is-cloud;
    in property <bool> provider-restart-required;
    in-out property <string> pending-api-key;
    callback provider-changed(string);
    callback save-provider-key(string, string);

    // ─ Language card props
    in property <[string]> source-language-options;
    in property <string> current-source-language;
    in property <[string]> target-mode-options;
    in property <string> current-target-mode;
    callback source-language-changed(string);
    callback target-mode-changed(string);

    background: Tokens.bg;

    HorizontalBox {
        spacing: 0;
        padding: 0;
        vertical-stretch: 1;

        // ─── Tab sidebar ───
        Rectangle {
            width: 240px;
            background: #0d0d0d;

            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Tokens.border;
            }

            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: start;

                SettingsTabButton {
                    icon: "⚙";  label: "System";        tab-id: "system";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "system"; }
                }
                SettingsTabButton {
                    icon: "⌨";  label: "Voice Typing";  tab-id: "voice-typing";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "voice-typing"; }
                }
                SettingsTabButton {
                    icon: "🎙";  label: "Recording";     tab-id: "recording";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "recording"; }
                }
                SettingsTabButton {
                    icon: "🌐";  label: "Language";      tab-id: "language";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "language"; }
                }
                SettingsTabButton {
                    icon: "📖";  label: "Dictionary";    tab-id: "dictionary";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "dictionary"; }
                }
                SettingsTabButton {
                    icon: "🔔";  label: "Notification";  tab-id: "notification";
                    current-tab: root.current-tab;
                    selected => { root.current-tab = "notification"; }
                }
            }
        }

        // ─── Content area ───
        Rectangle {
            background: Tokens.bg;
            horizontal-stretch: 1;

            ScrollView {
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;
                    alignment: start;

                    if root.current-tab == "system": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "System";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "STT engine + thông tin ứng dụng";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        ProviderCard {
                            provider-options: root.provider-options;
                            current-provider: root.current-provider;
                            show-api-key: root.provider-is-cloud;
                            restart-required: root.provider-restart-required;
                            pending-key <=> root.pending-api-key;
                            provider-changed(v) => { root.provider-changed(v); }
                            save-key(p, k) => { root.save-provider-key(p, k); }
                        }

                        // About card — version + tech stack + license
                        Rectangle {
                            background: Tokens.surface;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Tokens.border;

                            VerticalBox {
                                padding: 16px;
                                spacing: 8px;

                                HorizontalBox {
                                    spacing: 8px;
                                    alignment: start;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Tokens.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: "About Vọng AI Recorder";
                                        font-size: Tokens.font-secondary;
                                        font-weight: 600;
                                        color: Tokens.text-primary;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: "Version: 0.1.0-alpha.1";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "Built with Rust · Slint · whisper.cpp · Vulkan · cpal";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "License: AGPL-3.0-only · Privacy-first · BYOK";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-secondary;
                                }
                                Text {
                                    text: "Hotkey: Ctrl + Shift + R  (toggle main window)";
                                    font-size: Tokens.font-caption;
                                    color: Tokens.text-hint;
                                }
                            }
                        }
                    }

                    if root.current-tab == "voice-typing": SettingsPlaceholder {
                        tab-name: "Voice Typing";
                        icon: "⌨";
                        min-height: 320px;
                    }

                    if root.current-tab == "recording": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Recording";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "Nguồn âm thanh + tham số VAD";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        AudioSourceCard {
                            sources: root.audio-sources;
                            current: root.current-audio-source;
                            restart-needed: root.restart-needed;
                            selected(v) => { root.audio-source-changed(v); }
                        }
                    }

                    if root.current-tab == "language": VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "Language";
                            font-size: Tokens.font-h1;
                            font-weight: 700;
                            color: Tokens.text-primary;
                        }
                        Text {
                            text: "Ngôn ngữ nguồn (Bản gốc) + đích (Bản dịch)";
                            font-size: Tokens.font-secondary;
                            color: Tokens.text-secondary;
                        }
                        LanguagePickerCard {
                            source-options: root.source-language-options;
                            current-source: root.current-source-language;
                            target-options: root.target-mode-options;
                            current-target: root.current-target-mode;
                            source-changed(v) => { root.source-language-changed(v); }
                            target-changed(v) => { root.target-mode-changed(v); }
                        }
                    }

                    if root.current-tab == "dictionary": SettingsPlaceholder {
                        tab-name: "Dictionary";
                        icon: "📖";
                        min-height: 320px;
                    }

                    if root.current-tab == "notification": SettingsPlaceholder {
                        tab-name: "Notification";
                        icon: "🔔";
                        min-height: 320px;
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Vọng AI Recorder";
    // Soniox-style wide layout: sidebar 280 + main ≥ 800 = 1080 minimum
    width: 1280px;
    height: 800px;
    background: Tokens.bg;
    icon: @image-url("../assets/icon-64.png");

    // Driven by Rust at ~30 fps via Slint Timer.
    //   peak-level       — [0.0, 1.0] from vong-audio PeakMeter
    //   audio-status     — device + sample rate, or error if mic unavailable
    //   pipeline-status  — "🔇 Listening…" idle / "🗣 N utterances · …" active
    //   last-transcript  — most recent Whisper Final text (empty until first utterance)
    //   storage-status   — "📝 Session #N · X segments saved" or "📝 In-memory only"
    //   history-status   — formatted recent-sessions list (refreshed ~1Hz)
    in property <float> peak-level: 0.0;
    in property <string> audio-status: "Khởi tạo microphone…";
    in property <string> pipeline-status: "🔇  Listening…";
    in property <string> last-transcript: "";
    in property <string> storage-status: "📝  Initializing storage…";
    in property <string> history-status: "📜  Đang tải lịch sử…";
    in property <[TranscriptLine]> transcript-lines: [];
    callback search-changed(string);

    // Audio source picker
    in property <[string]> audio-sources;
    in property <string> current-audio-source;
    in property <bool> restart-needed: false;
    callback audio-source-changed(string);

    // Onboarding banner — only visible on first launch.
    in-out property <bool> onboarding-visible: false;
    callback dismiss-onboarding();

    // Export action
    in property <string> export-status: "";
    callback export-clicked();

    // Record toggle — default OFF until user clicks. Set in-out so the
    // button click can flip local state immediately while also notifying Rust.
    in-out property <bool> recording: false;
    callback record-toggled(bool);

    // Language pickers — Source (Bản gốc) + Target mode (Bản dịch)
    in property <[string]> source-language-options;
    in property <string> current-source-language;
    callback source-language-changed(string);
    in property <[string]> target-mode-options;
    in property <string> current-target-mode;
    callback target-mode-changed(string);

    // Provider picker (STT engine: Local Whisper / Soniox / OpenAI)
    in property <[string]> provider-mode-options;
    in property <string> current-provider-mode;
    in property <bool> provider-is-cloud: false;
    in property <bool> provider-restart-required: false;
    in-out property <string> pending-api-key;
    callback provider-mode-changed(string);
    callback save-provider-key(string, string);

    // View routing — "main" (transcript + sidebar) vs "settings" (full-screen
    // Soniox-style tabbed settings). The gear icon in HeaderBar flips it.
    in-out property <string> current-view: "main";
    in-out property <string> current-settings-tab: "recording";

    // Connection status indicator (bottom-left footer dot)
    in property <bool> provider-online: false;
    in property <string> provider-status-label: "Whisper local";

    // ──── Soniox-inspired layout ─────────────────────────────────────
    //   Header bar (compact)
    //   ┌─────────────┬──────────────────────────────────────────────┐
    //   │ Sidebar     │  Main content                                │
    //   │  280 px     │   - Live transcript stream (primary)         │
    //   │             │   - Peak meter + pipeline status (secondary) │
    //   │  • Source   │                                              │
    //   │  • History  │                                              │
    //   │  • Search   │                                              │
    //   │  • Export   │                                              │
    //   └─────────────┴──────────────────────────────────────────────┘
    //   Footer (compact)
    //
    // Hero block + Phase 0 status card removed — Soniox dashboards prioritize
    // the transcript over branding chrome. App branding stays in HeaderBar
    // (logo + "Vọng AI Recorder" text) and footer ("vong-ai-recorder · Privacy-first · BYOK").
    VerticalBox {
        padding: 0px;
        spacing: 0px;

        HeaderBar {
            in-settings: current-view == "settings";
            settings-clicked => { root.current-view = "settings"; }
            back-clicked => { root.current-view = "main"; }
        }

        // ─── Settings view ───
        if current-view == "settings": SettingsScreen {
            current-tab <=> current-settings-tab;
            vertical-stretch: 1;

            audio-sources: audio-sources;
            current-audio-source: current-audio-source;
            restart-needed: restart-needed;
            audio-source-changed(v) => { root.audio-source-changed(v); }

            provider-options: provider-mode-options;
            current-provider: current-provider-mode;
            provider-is-cloud: provider-is-cloud;
            provider-restart-required: provider-restart-required;
            pending-api-key <=> pending-api-key;
            provider-changed(v) => { root.provider-mode-changed(v); }
            save-provider-key(p, k) => { root.save-provider-key(p, k); }

            source-language-options: source-language-options;
            current-source-language: current-source-language;
            target-mode-options: target-mode-options;
            current-target-mode: current-target-mode;
            source-language-changed(v) => { root.source-language-changed(v); }
            target-mode-changed(v) => { root.target-mode-changed(v); }
        }

        // ─── Main view: two-column body. Sidebar left, transcript-dominated main right.
        if current-view == "main": HorizontalBox {
            spacing: 0px;
            padding: 0px;

            // Sidebar — fixed 320 px (Soniox uses ~280-320 px), scrollable
            Rectangle {
                width: 320px;
                background: #0d0d0d;  // slightly darker than bg for sidebar separation
                border-width: 0;
                // Right hairline border
                Rectangle {
                    x: parent.width - 1px;
                    y: 0;
                    width: 1px;
                    height: parent.height;
                    background: Tokens.border;
                }

                ScrollView {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        alignment: start; // cards size to content, no stretch fill

                        if onboarding-visible: OnboardingBanner {
                            dismiss => {
                                root.onboarding-visible = false;
                                root.dismiss-onboarding();
                            }
                        }

                        // Audio source / Provider / Language pickers moved to
                        // the Settings screen (⚙ Header). Sidebar here keeps
                        // only per-session controls (history + export) plus
                        // the first-run onboarding banner above.

                        HistoryCard {
                            text: history-status;
                            search-changed(q) => {
                                root.search-changed(q);
                            }
                        }

                        ExportCard {
                            status: export-status;
                            export-clicked => {
                                root.export-clicked();
                            }
                        }
                    }
                }
            }

            // Main content — two equal-width transcript panels (50/50) above
            // a single peak meter strip. Both panels share the same `lines`
            // model; one renders the auto-detect ("Bản gốc") fields, the other
            // renders the language-hinted ("Bản phiên âm") fields.
            VerticalBox {
                padding: 16px;
                spacing: 10px;
                horizontal-stretch: 1;

                // Stack:  ┌Bản gốc┐  ┌Bản dịch┐
                //          │       │  │        │
                //          ╰───────╯  ╰────────╯
                //                ╲ ◯ ╱
                //              ( Nhấn để ghi )
                //
                // The mic button "joins" the two columns from BELOW, sitting
                // in the gap between them. The columns themselves are normal
                // rounded rectangles — the button visually connects them via
                // its centered horizontal position + a slight upward overlap
                // (`y: -28px`) into the bottom border of both columns.
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;

                    // Row of two transcript columns — fills the WHOLE Rectangle
                    // minus the button cradle reserved at the bottom (60 px).
                    // The button visually overlaps into the columns' bottom
                    // edge (~30 px) so it looks like it "joins" them.
                    HorizontalBox {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height - 60px;
                        spacing: 10px;
                        padding: 0px;

                        TranscriptColumn {
                            lines: transcript-lines;
                            title: "Bản gốc";
                            use-original: true;
                            accent-color: #4ADE80; // success green — real-time / first
                            radius-br: 96px; // heavy curve toward the mic button
                            horizontal-stretch: 1;
                        }

                        TranscriptColumn {
                            lines: transcript-lines;
                            title: "Bản dịch";
                            use-original: false;
                            accent-color: Tokens.accent; // violet — translated
                            radius-bl: 96px; // heavy curve toward the mic button
                            horizontal-stretch: 1;
                        }
                    }

                    // Mic button cradle — anchored to the BOTTOM CENTER of
                    // the Rectangle so the round button sits horizontally
                    // centered between the two transcript columns above it.
                    // y starts inside the columns' bottom edge to give the
                    // "nối tiếp" (joining) feel the user asked for.
                    VerticalLayout {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height;
                        width: 160px;
                        height: 96px;
                        alignment: center;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: center;
                            RecordButton {
                                active: recording;
                                toggled(on) => {
                                    root.recording = on;
                                    root.record-toggled(on);
                                }
                            }
                        }
                        Text {
                            text: recording ? "● Đang ghi…  (nhấn để dừng)" : "Nhấn để ghi";
                            font-size: Tokens.font-caption;
                            font-weight: recording ? 700 : 400;
                            color: recording ? Tokens.danger : Tokens.text-hint;
                            horizontal-alignment: center;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }

                PeakMeter {
                    level: peak-level;
                    status: audio-status;
                    footer: pipeline-status;
                }
            }
        }

        // Footer — bottom-left shows provider connection status (label + dot),
        // bottom-right keeps the app handle.
        Rectangle {
            height: 36px;
            background: Tokens.surface;

            HorizontalBox {
                padding-left: 20px;
                padding-right: 20px;
                alignment: space-between;

                HorizontalBox {
                    spacing: 16px;
                    alignment: start;

                    HorizontalBox {
                        spacing: 8px;
                        alignment: start;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: provider-online ? Tokens.success : #555555;
                            border-width: 1px;
                            border-color: provider-online ? #166534 : #333333;
                            y: (parent.height - self.height) / 2;
                            animate background { duration: 200ms; }
                        }
                        Text {
                            text: provider-status-label + (provider-online ? "  ·  online" : "  ·  offline");
                            font-size: Tokens.font-caption;
                            color: provider-online ? Tokens.text-primary : Tokens.text-hint;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Privacy-first · BYOK · Audio never leaves your device";
                        font-size: Tokens.font-caption;
                        color: Tokens.text-hint;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "vong-ai-recorder";
                    font-size: Tokens.font-caption;
                    color: Tokens.text-hint;
                    vertical-alignment: center;
                }
            }

            // Top hairline border
            Rectangle {
                x: 0; y: 0;
                width: parent.width; height: 1px;
                background: Tokens.border;
            }
        }
    }
}
